                size = math.clamp(size, 0.1, 8)
                local unit = CFG.ModelHeight/5
                local light = groundColor:Lerp(Color3.new(1, 1, 1), 0.45)
                for i = 1, count do
                    if kind == 3 then
                        local dir = Vector3.new(math.random()-0.5, math.random()*0.8+0.2, math.random()-0.5)
                        if dir.Magnitude<0.01 then dir = Vector3.yAxis end
                        local v = dir.Unit*speed*(0.5+math.random()*0.5)
                        spawnParticle(pos, v, 0.45+math.random()*0.4, size*unit*0.45, 0.05, Color3.fromRGB(255, 230, 90), true, -6)
                    elseif kind == 2 then
                        local a = i/count*math.pi*2
                        local dir = Vector3.new(math.cos(a), 0, math.sin(a))
                        spawnParticle(pos+dir*0.8*unit, dir*speed+Vector3.yAxis,
                            0.5+math.random()*0.2, size*unit*0.35, size*unit, light, false, 1)
                    else
                        local a = math.random()*math.pi*2
                        local v = speed*(0.4+math.random()*0.6)
                        spawnParticle(pos+Vector3.new(0, 0.15*unit, 0),
                            Vector3.new(math.cos(a)*v, v*(0.3+math.random()*0.5), math.sin(a)*v),
