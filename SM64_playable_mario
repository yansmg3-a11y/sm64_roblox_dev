    -- SM64 death camera: locks onto Mario, slowly closes in on him and wobbles while he dies
    local deathCam, deathFov
    local function startDeathCam()
        if PK.puppet or deathCam then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local focus0 = (root and root.Parent) and root.Position or cam.Focus.Position
        local off = cam.CFrame.Position - focus0
        local dist0 = math.clamp(off.Magnitude, 8, 40)
        local dir = off.Magnitude > 0.1 and off.Unit or Vector3.new(0, 0.3, 1).Unit
        local fov0 = cam.FieldOfView
        deathFov = fov0
        local t0 = os.clock()
        cam.CameraType = Enum.CameraType.Scriptable
        deathCam = RunService.RenderStepped:Connect(function()
                local c = workspace.CurrentCamera
                if not c then return end
                local t = os.clock() - t0
                local k = math.clamp(t / 2.2, 0, 1)
                k = 1 - (1 - k) * (1 - k) -- ease out
                local dist = dist0 + (math.max(8, dist0 * 0.6) - dist0) * k -- pulls in towards Mario
                local ramp = math.clamp(t / 0.8, 0, 1)
                local sway = Vector3.new(math.sin(t * 1.9) * 0.5, math.sin(t * 2.7) * 0.35, 0) * ramp -- the wobble
                local roll = math.sin(t * 1.4) * math.rad(3.5) * ramp
                local focus = ((root and root.Parent) and root.Position or focus0) + Vector3.new(0, 1.5, 0)
                c.CameraType = Enum.CameraType.Scriptable
                c.CFrame = CFrame.lookAt(focus + dir * dist + sway, focus) * CFrame.Angles(0, 0, roll)
                c.FieldOfView = fov0 - 8 * k
        end)
        local prevKill = PK.fxKill
        PK.fxKill = function()
            if prevKill then pcall(prevKill) end
            -- a new Mario (or Mario switched off): give the normal camera back
            if deathCam then deathCam:Disconnect(); deathCam = nil end
            pcall(function()
                    local c = workspace.CurrentCamera
                    local ch = player.Character
                    local h = ch and ch:FindFirstChildOfClass("Humanoid")
                    if c then
                        c.CameraType = Enum.CameraType.Custom
                        if h then c.CameraSubject = h end
                        if deathFov then c.FieldOfView = deathFov end
                    end
            end)
        end
    end
    humanoid.Died:Connect(function()
            if PK.killed then return end
