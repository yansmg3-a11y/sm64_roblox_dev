                        pageLbl.Text = "PAGE " .. P.page .. " OF " .. pages
                        for s = 1, PER do
                            local sl = slots[s]
                            local it = list[(P.page - 1) * PER + s]
                            sl.it = it
                            sl.btn.Visible = it ~= nil
                            sl.name.Visible = it ~= nil
                            if it then
                                local on = it[2]() and true or false
                                sl.name.Text = clean(it[1])
                                sl.st.Text = on and "ON" or "OFF"
                                sl.st.TextColor3 = on and (it[6] and Color3.fromRGB(120, 170, 255) or Color3.fromRGB(70, 255, 100)) or Color3.fromRGB(235, 235, 235)
                                if hasImg then
                                    sl.btn.ImageColor3 = it[6] and (on and Color3.fromRGB(110, 150, 255) or Color3.fromRGB(165, 190, 255)) or (on and Color3.fromRGB(175, 255, 175) or Color3.new(1, 1, 1))
                                else
                                    sl.btn.BackgroundColor3 = it[6] and (on and Color3.fromRGB(70, 130, 240) or Color3.fromRGB(100, 130, 200)) or (on and Color3.fromRGB(100, 200, 110) or Color3.fromRGB(150, 165, 150))
                                end
                            end
                        end
                        local fi = slots[P.focus] and slots[P.focus].it
                        if not fi then P.focusSlot(1); fi = slots[1].it end
                        if fi then
                            local on = fi[2]() and true or false
                            local txt = fi[5] and fi[5]() or (fi[1] .. (on and "  ON" or "  OFF"))
                            hint.Text = clean(txt)
                        else
                            hint.Text = ""
                        end
                        backB.Visible = P.page > 1
                        nextB.Visible = P.page < pages
                        relayout()
                    end
                    for s = 1, PER do
                        local sl = slots[s]
                        sl.btn.MouseEnter:Connect(function() if sl.it then P.focusSlot(s); P.refresh() end end)
                        sl.btn.Activated:Connect(function()
                                if not sl.it then return end
                                P.focusSlot(s)
                                pcall(sl.it[3])
                                P.refresh()
                                menuRefresh()
                        end)
                    end
                    backB.Activated:Connect(function() P.page -= 1; P.focusSlot(1); P.refresh() end)
                    nextB.Activated:Connect(function() P.page += 1; P.focusSlot(1); P.refresh() end)
                    closeB.Activated:Connect(function() M64UI.toggle() end)
                    fxTrack(RunService.RenderStepped:Connect(function()
                                if not g.Enabled or not P.gloveBase then return end
                                local t = os.clock()
                                glove.Rotation = math.sin(t * 5) * 4
                                glove.Position = P.gloveBase + UDim2.fromScale(0, math.sin(t * 5) * 0.004)
                    end))

                    -- controller in the menu: D-pad or left stick moves the glove, A switches, B / START closes, L1 / R1 change page
                    do
                        local lastDir = Vector2.zero
                        local function moveGlove(dc, dr)
                            if not P.focus then return end
                            local col, row = (P.focus - 1) % 4, (P.focus - 1) // 4
                            col, row = col + dc, row + dr
                            if col < 0 or col > 3 or row < 0 or row > 3 then return end
                            local idx = row * 4 + col + 1
                            if slots[idx] and slots[idx].it then P.focusSlot(idx); P.refresh() end
                        end
                        local function changePage(d)
                            if (d < 0 and backB.Visible) or (d > 0 and nextB.Visible) then P.page += d; P.focusSlot(1); P.refresh() end
                        end
                        fxTrack(UIS.InputBegan:Connect(function(input)
                                    if not M64UI.open then return end
                                    local k = _M.pk(input.KeyCode)
                                    if k == Enum.KeyCode.DPadLeft then moveGlove(-1, 0)
                                    elseif k == Enum.KeyCode.DPadRight then moveGlove(1, 0)
                                    elseif k == Enum.KeyCode.DPadUp then moveGlove(0, -1)
                                    elseif k == Enum.KeyCode.DPadDown then moveGlove(0, 1)
                                    elseif k == Enum.KeyCode.ButtonL1 then changePage(-1)
                                    elseif k == Enum.KeyCode.ButtonR1 then changePage(1)
                                    elseif k == Enum.KeyCode.ButtonB then M64UI.toggle()
                                    elseif k == Enum.KeyCode.ButtonA then
                                        local sl = slots[P.focus]
                                        if sl and sl.it then pcall(sl.it[3]); P.refresh(); menuRefresh() end
                                    end
                        end))
                        fxTrack(UIS.InputChanged:Connect(function(input)
                                    if not M64UI.open or input.KeyCode ~= Enum.KeyCode.Thumbstick1 then return end
                                    local p = input.Position
                                    local d = Vector2.zero
                                    if math.abs(p.X) > 0.6 and math.abs(p.X) >= math.abs(p.Y) then d = Vector2.new(p.X > 0 and 1 or -1, 0)
                                    elseif math.abs(p.Y) > 0.6 then d = Vector2.new(0, p.Y > 0 and -1 or 1) end
                                    if d ~= lastDir then
                                        lastDir = d
                                        if d ~= Vector2.zero then moveGlove(d.X, d.Y) end
                                    end
                        end))
                    end
                    P.relayout = relayout
                end
                function M64UI.toggle()
                    local ok, e = pcall(M64UI.build)
                    if not ok then warn("[Mario64] menu error: " .. tostring(e)); return end
                    M64UI.gui.Enabled = not M64UI.gui.Enabled
                    M64UI.open = M64UI.gui.Enabled
                    _M.menuBlock = M64UI.open
                    if M64UI.open then P.refresh() end
                    menuRefresh()
                end
                _M.menuToggle = function() M64UI.toggle() end

            end
            fxTrack(UIS.InputBegan:Connect(function(input, gpe)
                        if gpe or UIS:GetFocusedTextBox() then return end
                        if input.KeyCode == Enum.KeyCode.X then setWing(not FXS.wing); menuRefresh()
                        elseif input.KeyCode == Enum.KeyCode.M then setMetal(not FXS.metal); menuRefresh() end
            end))
            FXS.onFlap = function()
                sfx("flap")
                stars(root.Position + Vector3.new(0, CFG.ModelHeight * 0.5, 0), 4, 6, 0.7)
            end
            if player:GetAttribute("M64Wing") then setWing(true, true); menuRefresh() end
            if player:GetAttribute("M64Metal") then
                -- meshes may still be building a frame later; apply once everything is parented
                task.defer(function() setMetal(true, true); menuRefresh() end)
            end

            CFG.GL.init = function()
                local GL = CFG.GL
                local rng = Random.new()
                local function R(a, b) return a + (b - a) * rng:NextNumber() end
                local function lvl() return math.clamp(opts.glitchLevel or 3, 1, 5) end
                local MULT = { 0.35, 0.7, 1.2, 2, 3.2 }
                local function roll(rate, dt) return rng:NextNumber() < 1 - math.exp(-rate * MULT[lvl()] * dt) end
                local function rcol() return Color3.new(rng:NextNumber(), rng:NextNumber(), rng:NextNumber()) end
                local ROTN = #ROT
                local ANIMS = {}
                for k in pairs(_M.MAP) do ANIMS[#ANIMS + 1] = k end
                table.sort(ANIMS)
                local FK = {}
                for k in pairs(FALL) do FK[#FK + 1] = k end
                table.sort(FK)
                local MATS = { Enum.Material.Neon, Enum.Material.Glass, Enum.Material.ForceField, Enum.Material.Foil, Enum.Material.Wood, Enum.Material.Ice }
                local OPTK = { "shadow", "particles", "sound", "lightFollow", "hitbox" }
                local CRASH = { "INVALID ANIMATION INDEX", "BONE TABLE CORRUPTED", "SEGMENT ADDRESS OUT OF RANGE", "OBJECT LIST OVERFLOW", "MARIO STATE 0xFFFFFFFF", "DMA TRANSFER FAILED" }
                local JUNK = "@#%&$?!/|~^*0123456789"
                local saved, conns, ui, warnGui = nil, {}, nil, nil
                local mode, modeT, frozen, hold = "normal", 0, nil, 0
                local crashT, buzzT, shakeT, uiT = 0, 0, 0, 0
                local function hex(n)
                    local t = {}
                    for i = 1, n do t[i] = string.format("%X", rng:NextInteger(0, 15)) end
                    return table.concat(t)
                end
                local function scramble(s)
                    local t = {}
                    for i = 1, #s do
                        local c = s:sub(i, i)
                        if c ~= " " and rng:NextNumber() < 0.3 then
                            local k = rng:NextInteger(1, #JUNK)
                            c = JUNK:sub(k, k)
                        end
                        t[i] = c
                    end
                    return table.concat(t)
                end
                local function mk(cls, props, parent)
                    local o = Instance.new(cls)
                    for k, v in pairs(props) do o[k] = v end
                    o.Parent = parent
                    return o
                end
                local function gsound(speed, vol)
                    if saved and saved.opts.voice == false then return end
                    local f = FALL[FK[rng:NextInteger(1, #FK)]]
                    local s = Instance.new("Sound")
                    s.SoundId = f[1]
                    s.PlaybackSpeed = speed
                    s.Volume = vol
                    s.RollOffMaxDistance = 150
                    s.Parent = root
                    pcall(function() s.TimePosition = R(0, 0.2) end)
                    s:Play()
                    Debris:AddItem(s, 2)
                end
                local function forceAnim()
                    GL.forcing = true
                    pcall(play, ANIMS[rng:NextInteger(1, #ANIMS)], R(0.2, 4), 0)
                    GL.forcing = false
                end
                -- bones: reset pose, wrong bone data, twisted, stretched, spinning, noisy, frozen, exploded
                local function mix(pose, pos, dt)
                    local H = CFG.ModelHeight
                    modeT -= dt
                    if modeT <= 0 then
                        local L = lvl()
                        if rng:NextNumber() < (5 - L) * 0.18 then
                            mode = "normal"
                        else
                            local m = { "reset", "swap", "twist", "stretch", "spin", "noise", "freeze", "explode" }
                            mode = m[rng:NextInteger(1, #m)]
                        end
                        modeT = R(0.15, 1.2) / (0.5 + L * 0.25)
                        frozen = nil
                    end
                    if crashT > 0 then mode = "freeze" end
                    if mode == "normal" then return pos end
                    local t = os.clock()
                    if mode == "freeze" then
                        if not frozen then frozen = { table.clone(pose), pos } end
                        for j = 1, ROTN do pose[j] = frozen[1][j] end
                        return frozen[2]
                    elseif mode == "reset" then
                        for j = 1, ROTN do pose[j] = CFrame.identity end
                        return Vector3.zero
                    elseif mode == "swap" then
                        local c = table.clone(pose)
                        for j = 1, ROTN do pose[j] = c[rng:NextInteger(1, ROTN)] end
                    elseif mode == "twist" then
                        for _ = 1, rng:NextInteger(3, 8) do
                            local j = rng:NextInteger(1, ROTN)
                            pose[j] = pose[j] * CFrame.Angles(R(-3.2, 3.2), R(-3.2, 3.2), R(-3.2, 3.2))
                        end
                    elseif mode == "stretch" then
                        for _ = 1, rng:NextInteger(3, 8) do
                            local j = rng:NextInteger(1, ROTN)
                            pose[j] = pose[j] * CFrame.new(R(-1, 1) * H * 0.6, R(-1, 1) * H * 0.6, R(-1, 1) * H * 0.6)
                        end
                    elseif mode == "spin" then
                        pose[1] = pose[1] * CFrame.Angles(t * 7, t * 12, 0)
                    elseif mode == "noise" then
                        for j = 1, ROTN do pose[j] = pose[j] * CFrame.Angles(R(-0.6, 0.6), R(-0.6, 0.6), R(-0.6, 0.6)) end
                        return pos + Vector3.new(R(-1, 1), R(-1, 1), R(-1, 1)) * H * 0.05
                    elseif mode == "explode" then
                        for j = 1, ROTN do
                            pose[j] = pose[j] * CFrame.new(math.sin(t * 9 + j) * H * 0.35, math.cos(t * 7 + j * 2) * H * 0.35, math.sin(t * 11 + j * 3) * H * 0.3)
                        end
                    end
                    return pos
                end
                GL.pose = function(pose, pos, dt)
                    local ok, r = pcall(mix, pose, pos, dt)
                    if ok and typeof(r) == "Vector3" then return r end
                    return pos
                end
                GL.block = function() return (not GL.forcing) and hold > os.clock() end
                -- distorted parts, wrong colors, flicker
                local function partTick(dt)
                    local s = 0.25 + lvl() * 0.35
                    for p, o in pairs(saved.parts) do
                        if roll(1.4, dt) then
                            local k = rng:NextNumber()
                            if k < 0.45 then
                                p.Size = o[1] * Vector3.new(R(1 / (1 + s), 1 + s * 2), R(1 / (1 + s), 1 + s * 2), R(1 / (1 + s), 1 + s * 2))
                            elseif k < 0.6 then
                                p.Size = o[1]
                            elseif o[3] < 1 then
                                if k < 0.75 then p.Color = rcol()
                                elseif k < 0.85 then p.Transparency = R(0, 0.85)
                                elseif k < 0.93 then p.Material = MATS[rng:NextInteger(1, #MATS)]
                                else p.Color, p.Transparency, p.Material = o[2], o[3], o[4] end
                            end
                        end
                    end
                end
                local function physTick(dt)
                    local L = lvl()
                    if roll(0.6, dt) then root.AssemblyLinearVelocity += Vector3.new(R(-1, 1), R(-0.3, 1), R(-1, 1)) * (6 + L * 14) end
                    if L >= 3 and roll(0.25, dt) then root.CFrame += Vector3.new(R(-1, 1), R(0, 1), R(-1, 1)) * L end
                    if roll(0.5, dt) then workspace.Gravity = saved.grav * R(0.15, 2.8)
                    elseif roll(0.4, dt) then workspace.Gravity = saved.grav end
                end
                -- wrong animations, wrong frames, animation data swapped, animation stops
                local function animTick(dt)
                    if roll(1.0, dt) then forceAnim(); hold = os.clock() + R(0.15, 1.4) end
                    if roll(0.9, dt) then curTime = R(0, 6) end
                    if roll(0.7, dt) then curTarget = R(0, 5) end
                    if roll(0.6, dt) then
                        local h = _M.MAP[ANIMS[rng:NextInteger(1, #ANIMS)]]
                        local d = h and getAnim(h)
                        if d then curData = d end
                    end
                    if roll(0.3, dt) then curName = nil; curData = nil; hold = os.clock() + R(0.3, 1.2) end
                end
                -- the script's own settings get scrambled
                local function dataTick(dt)
                    if roll(0.5, dt) then local k = OPTK[rng:NextInteger(1, #OPTK)]; opts[k] = not opts[k] end
                    if roll(0.25, dt) then PC.FaceLock = rng:NextInteger(1, 4) end
                    if roll(0.12, dt) then pcall(setWing, not FXS.wing, true) end
                    if roll(0.1, dt) then pcall(setMetal, not FXS.metal, true) end
                    if roll(0.3, dt) and saved.opts.particles ~= false then
                        pcall(stars, root.Position + Vector3.new(R(-2, 2), R(0, 5), R(-2, 2)), rng:NextInteger(2, 8), R(2, 14), R(0.3, 1.5))
                    end
                end
                local function sndTick(dt)
                    if roll(1.6, dt) then gsound(R(0.1, 3.5), R(0.25, 0.7)) end
                end
                local function camTick(dt)
                    local cam = workspace.CurrentCamera
                    if not cam then return end
                    local L = lvl()
                    if roll(1.0, dt) then shakeT = R(0.1, 0.5) end
                    if roll(0.8, dt) then
                        cam.FieldOfView = math.clamp(R(25, 60 + L * 14), 1, 120)
                    else
                        cam.FieldOfView = cam.FieldOfView + (saved.fov - cam.FieldOfView) * math.min(1, dt * 5)
                    end
                    if shakeT > 0 then
                        shakeT -= dt
                        local a = 0.02 * L
                        cam.CFrame = cam.CFrame * CFrame.Angles(R(-a, a), R(-a, a), R(-a * 2, a * 2))
                    end
                end
                local function buildUI()
                    local g = mk("ScreenGui", { Name = "MarioGlitchFX", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 900 }, PlayerGui)
                    local u = { gui = g, bars = {} }
                    u.crash = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Visible = false, ZIndex = 5 }, g)
                    u.crashTxt = mk("TextLabel", { Size = UDim2.fromScale(0.9, 0.5), Position = UDim2.fromScale(0.05, 0.25), BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Code, TextSize = 20, TextWrapped = true, ZIndex = 7 }, u.crash)
                    for i = 1, 20 do u.bars[i] = mk("Frame", { BorderSizePixel = 0, Visible = false, ZIndex = 6 }, g) end
                    u.txt = mk("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 40), TextColor3 = Color3.fromRGB(0, 255, 120), Font = Enum.Font.Code, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, Visible = false, ZIndex = 8 }, g)
                    u.cc = mk("ColorCorrectionEffect", { Name = "M64GlitchCC" }, Lighting_)
                    u.blur = mk("BlurEffect", { Name = "M64GlitchBlur", Size = 0 }, Lighting_)
                    u.stop = mk("TextButton", { Text = "STOP GLITCH", Size = UDim2.fromOffset(150, 38), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), BackgroundColor3 = Color3.fromRGB(220, 30, 30), TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 15, ZIndex = 20 }, g)
                    mk("UICorner", { CornerRadius = UDim.new(0, 10) }, u.stop)
                    u.stop.Activated:Connect(function() GL.stop() end)
                    return u
                end
                local function uiTick(dt)
                    uiT -= dt
                    if uiT > 0 then return end
                    uiT = R(0.04, 0.16)
                    local L = lvl()
                    for _, b in ipairs(ui.bars) do
                        if rng:NextNumber() < 0.04 * L then
                            b.Visible = true
                            b.Position = UDim2.fromScale(R(0, 0.5), R(0, 1))
                            b.Size = UDim2.new(R(0.1, 1), 0, 0, rng:NextInteger(2, 46))
                            b.BackgroundColor3 = rcol()
                            b.BackgroundTransparency = R(0.2, 0.8)
                        else
                            b.Visible = false
                        end
                    end
                    ui.txt.Visible = rng:NextNumber() < 0.1 * L
                    if ui.txt.Visible then
                        ui.txt.Position = UDim2.fromScale(R(0, 0.6), R(0, 0.9))
                        ui.txt.Text = "0x" .. hex(8) .. "  " .. hex(4) .. " " .. hex(4) .. "\n0x" .. hex(8) .. "  " .. hex(4) .. " " .. hex(4)
                    end
                    if rng:NextNumber() < 0.12 * L then
                        ui.cc.TintColor = rcol(); ui.cc.Saturation = R(-1, 2); ui.cc.Contrast = R(-0.6, 1); ui.cc.Brightness = R(-0.25, 0.25)
                        ui.blur.Size = R(0, 6 + L * 4)
                    elseif rng:NextNumber() < 0.4 then
                        ui.cc.TintColor = Color3.new(1, 1, 1); ui.cc.Saturation = 0; ui.cc.Contrast = 0; ui.cc.Brightness = 0
                        ui.blur.Size = 0
                    end
                    for i, it in ipairs(ITEMS) do
                        local r = rows[i]
                        if r and it[1] ~= "Glitch" and it[1] ~= "  Glitch level" then
                            if rng:NextNumber() < 0.05 * L then
                                r.Text = scramble(r.Text)
                                r.Rotation = R(-5, 5)
                            elseif r.Rotation ~= 0 and rng:NextNumber() < 0.3 then
                                r.Rotation = 0
                            end
                        end
                    end
                end
                -- fake crash screen (level 4 and 5): the picture freezes, static and a buzz, then it carries on
                local function crashTick(dt)
                    if crashT > 0 then
                        crashT -= dt
                        buzzT -= dt
                        if buzzT <= 0 then buzzT = 0.07; gsound(R(0.1, 0.4), 0.5) end
                        if crashT <= 0 then
                            ui.crash.Visible = false
                            frozen = nil; modeT = 0
                            forceAnim()
                            hold = os.clock() + R(0.5, 1.5)
                        end
                    elseif lvl() >= 4 and roll(0.02, dt) then
                        crashT = R(2.2, 4.2)
                        ui.crashTxt.Text = "MARIO 64 HAS STOPPED WORKING\n\n" .. CRASH[rng:NextInteger(1, #CRASH)] .. "\nAT 0x" .. hex(8)
                        ui.crash.Visible = true
                    end
                end
                GL.start = function()
                    if saved then return end
                    local cam = workspace.CurrentCamera
                    saved = { parts = {}, opts = {}, grav = workspace.Gravity, fov = cam and cam.FieldOfView or 70, face = PC.FaceLock, wing = FXS.wing, metal = FXS.metal }
                    for _, p in pairs(piece) do saved.parts[p] = { p.Size, p.Color, p.Transparency, p.Material } end
                    for _, k in ipairs({ "shadow", "particles", "sound", "lightFollow", "voice", "hitbox" }) do saved.opts[k] = opts[k] end
                    ui = buildUI()
                    mode, modeT, frozen, hold, crashT = "reset", 0.5, nil, 0, 0
                    opts.glitch = true
                    GL.on = true
                    conns[1] = fxTrack(RunService.Heartbeat:Connect(function(dt)
                                if not saved then return end
                                pcall(partTick, dt); pcall(physTick, dt); pcall(animTick, dt); pcall(dataTick, dt)
                                pcall(sndTick, dt); pcall(uiTick, dt); pcall(crashTick, dt)
                    end))
                    conns[2] = fxTrack(RunService.RenderStepped:Connect(function(dt)
                                if saved then pcall(camTick, dt) end
                    end))
                    gsound(0.25, 0.6)
                    menuRefresh()
                end
                GL.stop = function()
                    if not saved then return end
                    local s = saved
                    saved = nil
                    GL.on = false
                    opts.glitch = false
                    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
                    table.clear(conns)
                    for p, o in pairs(s.parts) do
                        pcall(function() p.Size, p.Color, p.Transparency, p.Material = o[1], o[2], o[3], o[4] end)
                    end
                    for k, v in pairs(s.opts) do opts[k] = v end
                    PC.FaceLock = s.face
                    pcall(function() workspace.Gravity = s.grav end)
                    pcall(function() local cam = workspace.CurrentCamera; if cam then cam.FieldOfView = s.fov end end)
                    pcall(function() if FXS.wing ~= s.wing then setWing(s.wing, true) end end)
                    pcall(function() if FXS.metal ~= s.metal then setMetal(s.metal, true) end end)
                    for _, r in pairs(rows) do pcall(function() r.Rotation = 0 end) end
                    if ui then
                        pcall(function() ui.gui:Destroy() end)
                        pcall(function() ui.cc:Destroy() end)
                        pcall(function() ui.blur:Destroy() end)
                        ui = nil
                    end
                    hold, mode, frozen, crashT = 0, "normal", nil, 0
                    curName = nil
                    menuRefresh()
                end
                GL.cycle = function() opts.glitchLevel = lvl() % 5 + 1 end
                GL.request = function()
                    if saved then GL.stop() else GL.warn() end
                end
                GL.shutdown = function()
                    pcall(GL.stop)
                    if warnGui then pcall(function() warnGui:Destroy() end); warnGui = nil end
                end
                GL.warn = function()
                    if warnGui then return end
                    local g = mk("ScreenGui", { Name = "MarioGlitchWarn", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1100 }, PlayerGui)
                    warnGui = g
                    local dim = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, BorderSizePixel = 0, Active = true }, g)
                    local box = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.9, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.fromRGB(32, 10, 10), BorderSizePixel = 0 }, dim)
                    mk("UICorner", { CornerRadius = UDim.new(0, 12) }, box)
                    mk("UISizeConstraint", { MaxSize = Vector2.new(380, 4000) }, box)
                    mk("UIStroke", { Color = Color3.fromRGB(235, 45, 45), Thickness = 3 }, box)
                    mk("UIPadding", { PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }, box)
