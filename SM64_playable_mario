        peerVariant = found and found.variant or 0
    end
    local PK = {
        killed = false, origT = {}, netpeer = mode == "netpeer",
        puppet = mode == "puppet" or mode == "netpeer",
        luigi = mode == "netpeer" and peerVariant == 1 or mode ~= "netpeer" and PC.Luigi == true,
        kit = mode == "netpeer" and peerVariant == 2 or mode ~= "netpeer" and PC.Kit == true and PC.Luigi ~= true,
        stant = mode == "netpeer" and peerVariant == 3 or mode ~= "netpeer" and PC.Stant == true and PC.Luigi ~= true and PC.Kit ~= true,
    }
    -- Spawn animation (SM64 menu > "Spawn Animation"): Mario drops in from the air spinning and lands. Turn it off in the menu.
    -- (kept in one table on purpose: this script is huge and Luau limits locals / upvalues per function)
    _M.SP = {
        pending = ((shared.M64Opts or {}).spawnAnim ~= false) and not PK.puppet,
        spin = false,
        height = 6,  -- how high Mario starts, in Mario-heights (6 = about 30 studs)
        rate = 600,  -- how fast he turns while falling, degrees per second
        fall = 0.65, -- swapped characters (Dante, Party Pony ...): how long the drop lasts, in seconds
        offset = CFrame.identity, -- visual drop / spin of a swapped character (only used while t0 is set)
        t0 = nil,
    }
    local EASY = {
        Size = 5,
        SizeAccurate = 3.9,
        RunSpeed = 38,
        AnimSpeed = 1.0,
        JumpPower = 1.0,
        Floatiness = 0.72,
        AttackDamage = 1.0,
        SlideAngle = 30,
        TextureId     = "",
        SM64Filter = true, -- true = N64 3-point texture filtering (the SM64 look) on every picture the script draws. Also a menu toggle.
        SM64FilterLeft = true, -- the 3-point triangle leans LEFT (false = the other way)
