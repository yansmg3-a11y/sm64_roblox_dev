                if a then
                    if a.fresh then
                        a.fresh = false
                        if curName == a.anim then curName = nil end
                        local sp = 1
                        local len = trackLength(a.anim, nil)
                        if len and not _M.LOOPED[a.anim] and a.track.Length > 0.05 then sp = math.clamp(len / a.track.Length, 0.4, 3) end
                        a.speed = sp
                    end
