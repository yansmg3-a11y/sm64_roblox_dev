                local m = p:FindFirstAncestorOfClass("Model")
                if m and m:FindFirstChildOfClass("Humanoid") and m ~= (ACC.carriedGet and ACC.carriedGet()) then return m end
            end
        end
        for _, d in ipairs(character:GetDescendants()) do
            if d:IsA("Attachment") then
                for _, c in ipairs(d:GetConstraints()) do
