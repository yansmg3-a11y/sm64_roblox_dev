local unknownSince = nil
local function tick()
    local g = detectGame()
    detectedText = g == nil and "UNKNOWN" or (g and "MATCH (Mario)" or "LOBBY (normal)")
    if g == nil then
        unknownSince = unknownSince or os.clock()
        if os.clock() - unknownSince > 4 and not PC.toldUnknown then
            PC.toldUnknown = true
            toast("Pursuitcore: can't tell lobby from match. Tap PC > Mode to force Mario (GAME) or normal (LOBBY).", 10)
        end
    else
        unknownSince = nil
    end
    if g == nil then g = PC.UnknownIsGame end
    -- my own character
    local char = localPlayer.Character
    if char and char.Parent and char:FindFirstChildOfClass("Humanoid") then
        local want = nil
        if not PC.Enabled then want = "play"
        elseif g then want = PC.Playable and "play" or "puppet" end
        local cur = REG[char]
        if cur and (cur.mode ~= want or cur.luigi ~= (PC.Luigi == true) or cur.kit ~= (PC.Kit == true and PC.Luigi ~= true) or cur.stant ~= (PC.Stant == true and PC.Luigi ~= true and PC.Kit ~= true)) then
            local snap = want and cur.snapshot and cur.snapshot()
            if snap then
                -- freeze the player while the other character is built; the new one restores the action
                shared.M64Handoff = shared.M64Handoff or {}
                shared.M64Handoff[char] = snap
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then hrp.Anchored = true end
                task.delay(4, function()
                        local H = shared.M64Handoff
                        if H and H[char] then
                            H[char] = nil
                            local r = char:FindFirstChild("HumanoidRootPart")
                            if r then r.Anchored = false end
                        end
                end)
            end
            cur.kill(); cur = nil
        end
        if want and not cur and not launching[char] then launch(char, want) end
    end
    local net = shared.M64Multiplayer
    if net and net.active then
        for p, peer in pairs(net.peers) do
            local other = p.Character
            if peer.mario and other and other ~= char and other.Parent and os.clock() - (peer.seen or 0) < 8 then
                local reg = REG[other]
                local wrongVariant = reg and ((peer.variant == 1) ~= reg.luigi
                    or (peer.variant == 2) ~= reg.kit
                    or (peer.variant == 3) ~= reg.stant)
                if reg and (reg.mode ~= "netpeer" or wrongVariant) then
                    reg.kill()
                    reg = nil
                end
                if not reg and not launching[other] and other:FindFirstChildOfClass("Humanoid")
                    and other:FindFirstChild("HumanoidRootPart") then
                    launch(other, "netpeer")
                end
            elseif other and REG[other] and REG[other].mode == "netpeer" then
                REG[other].kill()
            end
        end
    end
    for m in pairs(tracked) do
        if not m:IsDescendantOf(workspace) then
            if REG[m] then REG[m].kill() end
            tracked[m] = nil
        elseif m ~= char then
            local runningPeer = Players:GetPlayerFromCharacter(m)
            local isPeer = runningPeer and net and net.peers[runningPeer] and net.peers[runningPeer].mario
            if not isPeer then
                local want = m:GetAttribute("M64DevClone") == true or (PC.Enabled and g and swapMatch(m))
                local cur = REG[m]
                if cur and (not want or cur.luigi ~= (PC.Luigi == true)
                        or cur.kit ~= (PC.Kit == true and PC.Luigi ~= true)
                        or cur.stant ~= (PC.Stant == true and PC.Luigi ~= true and PC.Kit ~= true)) then
                    cur.kill()
                    cur = nil
                end
                if want and not cur and not launching[m] and m:FindFirstChildOfClass("Humanoid")
                    and m:FindFirstChild("HumanoidRootPart") then
                    launch(m, "puppet")
                end
            end
        end
    end
    pcall(iconSweep)
    if refreshMenu then pcall(refreshMenu) end
end
