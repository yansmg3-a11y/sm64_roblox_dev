        for _, v in ipairs({s.X, s.Y, s.Z}) do u16(b, math.clamp(math.floor(v*16+0.5), 1, 65535)) end
        local c = part.Color
        b[#b+1] = math.floor(c.R*255+0.5)
        b[#b+1] = math.floor(c.G*255+0.5)
        b[#b+1] = math.floor(c.B*255+0.5)
        local rx, ry, rz = part.CFrame:ToEulerAnglesYXZ()
        for _, a in ipairs({rx, ry, rz}) do
            u16(b, math.floor((a%(2*math.pi))/(2*math.pi)*65535+0.5))
        end
        b[#b+1] = (part.Transparency >= 0.95 and 1 or 0)+(part.CanCollide and 2 or 0)+(materialIDs[part.Material] or 1)*4
        return b
    end
    local function untrackWorldPart(part, sendGone)
        local id = parts[part]
        if not id then return end
        parts[part] = nil
        local key = "world:"..id
        Net.history[key] = nil
        for i, k in ipairs(Net.historyKeys) do if k == key then table.remove(Net.historyKeys, i)
                break end end
        if sendGone then enqueue(WORLD_REMOVE, {id}, nil, true) end
    end
    local function trackWorldPart(part)
        if not part:IsA("BasePart") or parts[part] then return end
        local id
        for _ = 1, 255 do
            local possible = nextPartId
            nextPartId = nextPartId%255+1
            local used = false
            for _, val in pairs(parts) do if val == possible then used = true
                    break end end
            if not used then id = possible
                break end
        end
        if not id then return end
        parts[part] = id
        local function publish()
            if not parts[part] or not part:IsDescendantOf(localFolder) then return end
            local data = serializeWorldPart(id, part)
            local key = "world:"..id
            if Net.history[key] and table.concat(Net.history[key][2],",") == table.concat(data,",") then return end
            enqueue(WORLD_SET, data, key)
        end
        publish()
        for _, prop in ipairs({"CFrame","Size","Color","Transparency","CanCollide","Material"}) do
            Net.connections[#Net.connections+1] = part:GetPropertyChangedSignal(prop):Connect(function()
                    if ignoredParts[part] then return end
                    local last = part:GetAttribute("M64PublishAt") or 0
                    if os.clock()-last>0.12 then
                        part:SetAttribute("M64PublishAt", os.clock())
                        publish()
                    else
                        task.delay(0.14, function() if parts[part] then publish() end end)
                    end
            end)
        end
        Net.connections[#Net.connections+1] = part.AncestryChanged:Connect(function()
                if not part:IsDescendantOf(localFolder) then untrackWorldPart(part, true) end
        end)
    end
    for _, d in ipairs(localFolder:GetDescendants()) do trackWorldPart(d) end
    Net.connections[#Net.connections+1] = localFolder.DescendantAdded:Connect(trackWorldPart)
    local function renderWorldPart(peer, msg, d)
        if #d<1 then return end
        local id = d[1]
        if id<1 or id>255 then return end
        local uid = tostring(peer.player.UserId)
        local folder = world:FindFirstChild(uid) or Instance.new("Folder")
        folder.Name = uid
        folder.Parent = world
        peer.world = peer.world or {}
        local part = peer.world[id]
        if msg == WORLD_REMOVE then
            if part then part:Destroy()
                peer.world[id] = nil end
            return
        end
        if #d ~= 29 then return end
        if not part then
            part = Instance.new("Part")
            part.Name = "PeerPart_"..id
            part.Anchored = true
            part.CanTouch = false
            part.Parent = folder
            peer.world[id] = part
        end
        local x, y, z = readI32(d, 2)/16, readI32(d, 6)/16, readI32(d, 10)/16
        local sx, sy, sz = readU16(d, 14)/16, readU16(d, 16)/16, readU16(d, 18)/16
        local rx = readU16(d, 23)/65535*2*math.pi
        local ry = readU16(d, 25)/65535*2*math.pi
        local rz = readU16(d, 27)/65535*2*math.pi
        part.Size = Vector3.new(math.max(0.05, sx), math.max(0.05, sy), math.max(0.05, sz))
        part.CFrame = CFrame.new(x, y, z)*CFrame.fromEulerAnglesYXZ(rx, ry, rz)
        part.Color = Color3.fromRGB(d[20], d[21], d[22])
        local flags = d[29]
        part.Transparency = flags%2 == 1 and 1 or 0
        part.CanCollide = math.floor(flags/2)%2 == 1
        part.Material = materialByIndex[math.floor(flags/4)] or Enum.Material.Plastic
    end
    local function removePeer(p)
        local peer = Net.peers[p]
        if not peer then return end
        local rend = Net.renderers[p]
        if rend and rend.kill then pcall(rend.kill) end
        Net.renderers[p] = nil
        if peer.world then for _, obj in pairs(peer.world) do pcall(function() obj:Destroy() end) end end
        local f = world:FindFirstChild(tostring(p.UserId))
        if f then f:Destroy() end
        Net.peers[p] = nil
        lastFrames[p] = nil
    end

    local function handlePacket(peer, msg, d)
        if msg == HELLO then
            if #d ~= 3 or d[1] ~= 77 or d[2] ~= 54 or d[3] ~= 3 then return end
            if not peer.mario then
                peer.mario = true
                disconnectTracks()
                for _, key in ipairs(Net.historyKeys) do
                    local item = Net.history[key]
                    if item then enqueue(item[1], item[2]) end
                end
                nextPose = 0
            end
            return
        end
        if not peer.mario then return end
        if msg == ACTION then
            if #d ~= 2 then return end
            local animation = Net.animNames[d[1]]
            if animation then
                peer.pose = peer.pose or {face = 1, flags = 0}
                peer.pose.anim = animation
                peer.pose.speed = math.max(0.1, d[2]/30)
                peer.pose.receivedAt = os.clock()
            end
        elseif msg == POSE then
            if #d ~= 6 then return end
            local anim = Net.animNames[d[2]]
            peer.variant = math.clamp(d[1], 0, 3)
            peer.pose = {anim = anim or "idle", speed = math.max(0.1, d[3]/30), face = math.clamp(d[4], 1, 7),
                healthFraction = d[5]/255, stateCode = d[6], receivedAt = os.clock()}
        elseif msg == SETTINGS then
            if #d ~= 3 or d[1] < 40 or d[1] > 200 or d[2] > 127 or d[3] > 7 then return end
            local flags = d[2]
            peer.settings = {
                height = d[1] / 20,
                accurate = bit32.band(flags, 8) ~= 0,
                wing = bit32.band(flags, 1) ~= 0,
                metal = bit32.band(flags, 2) ~= 0,
                mimic = bit32.band(flags, 4) ~= 0,
                filter = bit32.band(flags, 16) ~= 0,
                gliding = bit32.band(flags, 32) ~= 0,
                combatOff = bit32.band(flags, 64) ~= 0,
                face = d[3],
            }
        elseif msg == FX then
            if #d ~= 7 or (d[1] ~= 1 and d[1] ~= 2 and d[1] ~= 3) then return end
            local c = peer.player.Character
            local receiverRoot = c and c:FindFirstChild("HumanoidRootPart")
            if not receiverRoot then return end
            local pos = receiverRoot.Position+Vector3.new((d[5]-128)/8, (d[6]-128)/8, (d[7]-128)/8)
            local item = {d[1], math.clamp(d[2], 1, 24), d[3]/4, d[4]/20, pos}
            local rend = Net.renderers[peer.player]
            if rend and rend.particle then rend.particle(table.unpack(item))
            else
                peer.pendingFX = peer.pendingFX or {}
                peer.pendingFX[#peer.pendingFX+1] = {item, os.clock()}
                if #peer.pendingFX>8 then table.remove(peer.pendingFX, 1) end
            end
        elseif msg == SOUND then
            if #d<1 then return end
            local snd = SOUND_NAMES[d[1]]
            local rend = Net.renderers[peer.player]
            if snd then
                if rend and rend.sound then rend.sound(snd)
                else
                    peer.pendingSounds = peer.pendingSounds or {}
                    peer.pendingSounds[#peer.pendingSounds+1] = {snd, os.clock()}
                    if #peer.pendingSounds>8 then table.remove(peer.pendingSounds, 1) end
                end
            end
        elseif msg == HIT then
            if #d ~= 9 then return end
            local to = 0
            for j = 1, 5 do to = to*256+d[j] end
            if to ~= localPlayer.UserId then return end
            if (shared.M64Opts or {}).combat == false then return end -- Combat Mode is off
            local damage = readU16(d, 6)/10
            local kind = attackNames[d[8]]
            if not kind or damage <= 0 or damage>MAX_DAMAGE[kind]*1.01 then return end
            peer.attackNonces = peer.attackNonces or {}
            local previous = peer.attackNonces[d[9]]
            if previous and os.clock()-previous<4 then return end
            peer.attackNonces[d[9]] = os.clock()
            local char = localPlayer.Character
            local victim = char and char:FindFirstChildOfClass("Humanoid")
            local victimRoot = char and char:FindFirstChild("HumanoidRootPart")
            local origin = peer.player.Character and peer.player.Character:FindFirstChild("HumanoidRootPart")
            if not victim or not victimRoot or not origin or victim.Health <= 0 then return end
            if (victimRoot.Position-origin.Position).Magnitude>20 then return end
            if os.clock()-(peer.lastAttack or 0)<0.10 then return end
            peer.lastAttack = os.clock()
            -- Client feedback; server damage requires game support.
            pcall(function() victim:TakeDamage(damage) end)
            pcall(function()
                    local diff = victimRoot.Position-origin.Position
                    local flatDir = Vector3.new(diff.X, 0, diff.Z)
                    if flatDir.Magnitude>0.2 then
                        victimRoot.AssemblyLinearVelocity = flatDir.Unit*35+Vector3.new(0, 22, 0)
                    end
            end)
        elseif msg == WORLD_SET or msg == WORLD_REMOVE then
            renderWorldPart(peer, msg, d)
        end
    end
    local function pollPeer(player)
        local raw = receiveFrame(player)
        if not raw then
            local peer = Net.peers[player]
            if peer and os.clock()-(peer.seen or 0)>10 then removePeer(player) end
            return
        end
        local sig = table.concat(raw,",")
        if lastFrames[player] ~= sig then lastFrames[player] = sig
            return end
        local peer = Net.peers[player]
        if not peer then
            peer = {player = player, seen = os.clock(), joined = os.clock(), lastSeq = nil, mario = false}
            Net.peers[player] = peer
        end
        peer.seen = os.clock()
        if peer.lastSeq == raw[1] then return end
        if peer.lastSeq and raw[1] ~= (peer.lastSeq+1)%256 then peer.msg = nil end
        peer.lastSeq = raw[1]
        local j = 3
        if not peer.msg then j = raw[2] == 0 and FRAME_DATA_BYTES+3 or raw[2]+2 end
        while j <= FRAME_DATA_BYTES+2 do
            local b = raw[j]
            local m = peer.msg
            if not m then
                if b ~= 0 then peer.msg = {type = b, data = {}} end
            elseif m.len == nil then
                m.len = b
                if b == 0 then local typ = m.type
                    peer.msg = nil
                    handlePacket(peer, typ, {}) end
            else
                m.data[#m.data+1] = b
            end
            m = peer.msg
            if m and m.len and #m.data >= m.len then peer.msg = nil
                handlePacket(peer, m.type, m.data) end
            j+=1
        end
    end

    local lastPoseKey, lastPoseKeepalive = nil, 0
    local function publishPose()
        if not Net.snapshot or Net.localCharacter ~= localPlayer.Character or not Net.animLoaded then return end
        if os.clock()<nextPose then return end
        nextPose = os.clock()+0.08 -- how often the pose (what Mario is doing) is sent
        local ok, s = pcall(Net.snapshot)
        if not ok or not s then return end
        local anim = s.anim or "idle"
        local state = tostring(s.state or "Idle")
        local lower = string.lower(anim.." "..state)
        local id = Net.animIDs[anim] or Net.animIDs.idle or 0
        local speed = math.clamp(math.floor((s.animSpeed or 1)*30+0.5), 1, 255)
        local face, code = 1, 0
        if s.health and s.health <= 0 or lower:find("dying", 1, true) or state == "Dead" then face = 4
            code = 4
        elseif lower:find("hurt", 1, true) or lower:find("bonk", 1, true) or lower:find("squish", 1, true)
            or lower:find("grabbed", 1, true) then face = 3
            code = 3
        elseif lower:find("sleep", 1, true) then face = 3
            code = 5
        elseif lower:find("punch", 1, true) or lower:find("kick", 1, true) or lower:find("dive", 1, true)
            or lower:find("pound", 1, true) or lower:find("slide", 1, true) then face = 7
            code = 2
        elseif lower:find("backflip", 1, true) or lower:find("jump", 1, true) or lower:find("wall_kick", 1, true) then face = 6
            code = 6
        elseif lower:find("skid", 1, true) or lower:find("ledge", 1, true) then face = 5
            code = 7
        end
        local variant = 0
        if Net.variant then local v = Net.variant()
            variant = math.clamp(tonumber(v) or 0, 0, 3) end
        local health = (s.health and s.maxHealth and s.maxHealth>0) and math.clamp(s.health/s.maxHealth, 0, 1) or 1
        local hp = math.floor(health*255+0.5)
        local d = {variant, id, speed, face, hp, code}
        local key = table.concat(d,",")

        if key == lastPoseKey and os.clock()<lastPoseKeepalive then return end
        lastPoseKey = key
        lastPoseKeepalive = os.clock()+1
        enqueue(POSE, d)
    end
    local nextSettingsKeepalive = 0
    local function publishSettings()
        if not Net.settingsSnapshot or Net.localCharacter ~= localPlayer.Character then return end
        local ok, settings = pcall(Net.settingsSnapshot)
        if not ok or not settings then return end
        local height = math.clamp(math.floor((settings.height or 5) * 20 + 0.5), 40, 200)
        local flags = (settings.wing and 1 or 0) + (settings.metal and 2 or 0)
            + (settings.mimic and 4 or 0) + (settings.accurate and 8 or 0) + (settings.combatOff and 64 or 0)
            + (settings.filter and 16 or 0) + (settings.gliding and 32 or 0)
        local face = math.clamp(tonumber(settings.face) or 0, 0, 7)
        local data = {height, flags, face}
        local key = table.concat(data, ",")
        local changed = key ~= Net.sentSettings
        if not changed and os.clock() < nextSettingsKeepalive then return end
        Net.sentSettings = key
        nextSettingsKeepalive = os.clock() + 4
        enqueue(SETTINGS, data, "visual", changed)
    end
    local nextPeerScan, nextHello = 0, 0
    Net.connections[#Net.connections+1] = RunService.Heartbeat:Connect(function()
            if not Net.active then return end
            if os.clock() >= nextHello then
                nextHello = os.clock()+2
                enqueue(HELLO, {77, 54, 3}, nil, true)
            end
            publishSettings()
            publishPose()
            publishFrame()
            if os.clock()<nextPeerScan then return end
            nextPeerScan = os.clock()+0.04
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= localPlayer then pcall(pollPeer, p) end
            end
    end)
    Net.connections[#Net.connections+1] = Players.PlayerAdded:Connect(function()
            disconnectTracks()
            nextPose = 0
    end)
    Net.connections[#Net.connections+1] = Players.PlayerRemoving:Connect(removePeer)
    Net.connections[#Net.connections+1] = localPlayer.CharacterAdded:Connect(function()
            disconnectTracks()
            Net.localCharacter = nil
            Net.snapshot = nil
            Net.settingsSnapshot = nil
    end)

    function Net.stop()
        if not Net.active then return end
        Net.active = false
        disconnectTracks()
        for _, c in ipairs(Net.connections) do pcall(function() c:Disconnect() end) end
        pcall(Net.battle.shutdown)
        for p in pairs(Net.peers) do removePeer(p) end
        if shared.M64Multiplayer == Net then shared.M64Multiplayer = nil end
    end
end

