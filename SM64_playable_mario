    function _M.flatten(sx, sy)
        local idx = {}
        for j, n in ipairs(ROT) do idx[n] = j end
        local y0 = baseC0[1].Position.Y
        local rel, new = {}, {}
        for j, name in ipairs(ROT) do
            local m = motors[j]
            local own = m.C0 * m.C1:Inverse()
            rel[j] = (j == 1) and own or (rel[idx[_M.PARENT[name]]] * own)
            local p = rel[j].Position
            new[j] = CFrame.new(p.X * sx, y0 + (p.Y - y0) * sy, p.Z * sx) * rel[j].Rotation
        end
        local function fac(v) return math.sqrt((v.X * sx) ^ 2 + (v.Y * sy) ^ 2 + (v.Z * sx) ^ 2) end
        for j, name in ipairs(ROT) do
            local m = motors[j]
            if j == 1 then m.C0 = new[1] * m.C1
            else m.C0 = new[idx[_M.PARENT[name]]]:Inverse() * new[j] * m.C1 end
