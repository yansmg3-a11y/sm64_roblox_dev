            local function emitParticleBurst(kind, count, speed, size, pos, synthetic)
                local opts = shared.M64Opts
                if (opts and opts.particles == false) or not effectsFolder.Parent then return end
                if not synthetic then lastEffectPacket = os.clock() end
                if typeof(pos) ~= "Vector3" then return end
                count = math.clamp(math.floor(count), 1, 24)
