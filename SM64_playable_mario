        h = math.clamp(tonumber(h) or CFG.ModelHeight, 2, 10)
        local ratio = h / CFG.ModelHeight
        if math.abs(ratio - 1) < 0.001 then return end
        CFG.ModelHeight = h
        S *= ratio
        _M.groundAdj *= ratio
        posScale = S
        for _, part in ipairs(marioModel:GetChildren()) do
            if part:IsA("BasePart") then part.Size *= ratio end
        end
        for _, part in ipairs(marioModel:GetDescendants()) do
            if part:IsA("Weld") then
                part.C0 = part.C0.Rotation + part.C0.Position * ratio
            end
        end
        for name, offset in pairs(center) do center[name] = offset * ratio end
        for j, name in ipairs(ROT) do
            nodeT[j] *= ratio
            local motor = motors[j]
            if name == "Body" then
                motor.C0 = _M.bodyC0()
                motor.C1 = CFrame.new(-center[name])
            else
                motor.C0 = CFrame.new(-center[_M.PARENT[name]])
