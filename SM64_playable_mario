                    else
                        local alpha = p.t/p.life
                        p.vel = p.vel*math.max(0, 1-3*dt)+Vector3.new(0, p.grav*dt, 0)
                        p.pos+=p.vel*dt
                        p.angle+=p.spin*dt
                        p.p.Position = p.pos
                        local sz = math.max(p.s0+(p.s1-p.s0)*alpha, 0.03)*p.k
                        p.bb.Size = UDim2.fromScale(sz, sz)
                        local fade = alpha>0.6 and (alpha-0.6)/0.4*0.95 or 0
                        p.img.Rotation = p.angle
                        p.star.Rotation = p.angle
                        if p.isStar then p.star.TextTransparency = fade
                        else
