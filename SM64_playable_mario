                local function silence(s)
                    if muted[s] ~= nil or not isStep(s) then return end
                    local v = s.Volume
                    if v <= 0 then v = 0.65 end
                    muted[s] = v
                    local function off()
                        if stepOn() then pcall(function() s.Volume = 0; if s.Playing then s.Playing = false end end) end
                    end
                    off()
                    pcall(function() s:GetPropertyChangedSignal("Playing"):Connect(off) end)
                    pcall(function() s:GetPropertyChangedSignal("Volume"):Connect(off) end)
                    pcall(function() s:GetPropertyChangedSignal("SoundId"):Connect(off) end)
                end
                -- on = true: muted again, false: Roblox's step sound plays again
                function _M.muteRbxSteps(on)
                    for s, v in pairs(muted) do
                        pcall(function() if on then s.Volume = 0; s.Playing = false else s.Volume = v end end)
                    end
                end
                pcall(function() if shared.M64StepConn then shared.M64StepConn:Disconnect() end end)
                shared.M64StepConn = workspace.DescendantAdded:Connect(function(d) pcall(silence, d) end)
                task.spawn(function()
                        for i, d in ipairs(workspace:GetDescendants()) do
                            pcall(silence, d)
                            if i % 4000 == 0 then task.wait() end
                        end
                end)
            end

            task.spawn(function()
                    for name in pairs(_M.SOUND_FALLBACKS) do
                        _M.soundAsset(name)
                    end
            end)
            local function sfx(name, volume)
                if not opts.voice then return end
                if PK.stant and _M.STANT_TEXT[name] then -- Stant has no voice: a speech bubble instead of the sound
                    _M.stantBubble(root, _M.STANT_TEXT[name], CFG.ModelHeight)
                    if not PK.netpeer then
                        local net = shared.M64Multiplayer
                        if net then net.sendSound(name) end
                    end
                    return
                end
                local asset, playback = _M.soundAsset(name)
                if not asset then return end
                local sound = Instance.new("Sound")
                sound.SoundId = asset
                sound.PlaybackSpeed = playback * (0.97 + math.random() * 0.06)
                sound.Volume = volume or 1
                sound.RollOffMaxDistance = 150
