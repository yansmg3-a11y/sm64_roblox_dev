    function _M.soundAsset(name)
        local fallback = _M.SOUND_FALLBACKS[name]
        if not fallback then return nil end

        local cached = shared.M64SoundAssets[name]
        if cached then return cached[1], cached[2] end

        local source = _M.SOUNDS[name]
        local asset
        if type(source) == "string" and source ~= "" then
            if source:match("^https?://") then
                local ok, result = pcall(function()
                        if not (isfile and writefile and getcustomasset) then return nil end
                        local filename = source:match("([^/]+)$") or (name .. ".mp3")
                        if not filename:match("%.mp3$") then filename = filename .. ".mp3" end
                        if not isfile(filename) then
                            local bytes = game:HttpGet(source)
                            if type(bytes) ~= "string" or #bytes == 0 then return nil end
                            writefile(filename, bytes)
                        end
                        return getcustomasset(filename)
                end)
                if ok then asset = result end
            else
                asset = source
            end
        end

        if not asset and _M.KIT_VOICE[name] then -- GitHub file not there (yet): use the copy packed inside the script
            pcall(function()
                    if isfile and writefile and getcustomasset then
                        local fn = "m64_kit_" .. name .. ".mp3"
                        if not isfile(fn) then writefile(fn, buffer.tostring(_M.b64buffer(_M.KIT_VOICE[name]))) end
                        asset = getcustomasset(fn)
                    end
            end)
        end
        local result = {asset or fallback[1], asset and 1 or fallback[2]}
        shared.M64SoundAssets[name] = result
        return result[1], result[2]
    end


