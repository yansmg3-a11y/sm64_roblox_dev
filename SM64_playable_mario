    function ACC.onLand(from)
        if _M.spawnFall then _M.spawnFall = false; ACC.peak, ACC.maxDown = root.Position.Y, 0; return false end -- the spawn drop is harmless
        if not accOn() then return false end
        local drop, down = ACC.peak - root.Position.Y, ACC.maxDown
        ACC.peak, ACC.maxDown = root.Position.Y, 0
        if from == "GroundPound" then return false end
        local u = CFG.ModelHeight / 160 -- SM64 units -> studs
        if drop > 1150 * u and down > 55 * 30 * u * 0.7 then
            ACC.startSquish(drop > 3000 * u and 0.75 or 0.5, "fall")
            return true
        end
        return false
    end
    -- one frame of the reaction AI. true = it took over this frame (the normal moveset is skipped)
    function ACC.step(dt)
        if not accOn() then
            if ACC.mode or _M.squash.sx ~= 1 or _M.squash.sy ~= 1 then
                ACC.mode, ACC.grabber = nil, nil
                accSquash(1, 1)
                if state == "Hurt" or state == "Grabbed" or state == "Squish" then setState("Idle"); play("idle", 1, 0.1) end
            end
            ACC.peak, ACC.maxDown = root.Position.Y, 0
            return false
        end
        local now = os.clock()
        local v = root.AssemblyLinearVelocity
        local fl = humanoid.FloorMaterial ~= Enum.Material.Air
        local y = root.Position.Y
        -- fall height bookkeeping
        if state == "Swim" or state == "Ledge" or state == "LedgeClimb" or ACC.mode then
            ACC.peak, ACC.maxDown = y, 0
        elseif fl and not AIR[state] then
            ACC.peak, ACC.maxDown = y, 0
        else
            ACC.peak = math.max(ACC.peak, y)
            ACC.maxDown = math.max(ACC.maxDown, -v.Y)
        end
        -- being grabbed
        if now >= ACC.scan then
            ACC.scan = now + 0.15
            local ok, g = pcall(accGrabber)
            ACC.grabber = ok and g or nil
            if ACC.grabber then
                local gr = ACC.grabber:FindFirstChild("HumanoidRootPart")
                if gr then ACC.grabPos = gr.Position end
            end
        end
        if ACC.grabber and ACC.mode ~= "Squish" then
            if ACC.mode ~= "Grabbed" then
                ACC.mode, ACC.t, ACC.hit = "Grabbed", 0, nil
                hv, fVel = Vector3.zero, 0
                setState("Grabbed")
                play("backward_air_kb", 0.7, 0.1)
            end
            humanoid:Move(Vector3.zero, false)
            humanoid.WalkSpeed = 0.01
            return true -- do not touch Mario's CFrame: the grabber is moving him
        elseif ACC.mode == "Grabbed" then
            -- let go: he is thrown with whatever speed he has
            accKnock(0.1, ACC.grabPos, root.AssemblyLinearVelocity)
            return true
        end
        -- knocked back
        if ACC.mode == "Hurt" then
            ACC.t += dt
            if ACC.phase == "air" then
                humanoid:Move(Vector3.zero, false)
                humanoid.WalkSpeed = 0.01
                local vy = v.Y
                if sm64Gravity then
                    local U = CFG.ModelHeight / 160
                    vy = math.max(vy + (workspace.Gravity - 4 * 900 * U) * dt, -75 * 30 * U)
                else
                    vy += (workspace.Gravity - CFG.NetG()) * dt
                end
                root.AssemblyLinearVelocity = Vector3.new(ACC.kb.X, vy, ACC.kb.Z)
                if (ACC.t > 0.15 and fl and v.Y < 5) or ACC.t > 2.5 then
                    ACC.phase, ACC.t = "slide", 0
                    play(ACC.front and "hurt_front" or "hurt_back", 1, 0.03)
                end
            else
                ACC.kb = ACC.kb * math.max(0, 1 - (ACC.hard and 3.2 or 4.5) * dt)
                groundDrive(ACC.kb.Magnitude, yawOf(ACC.kb))
                local len = math.max(trackLength(ACC.front and "hurt_front" or "hurt_back", 0.8), 0.6)
                if ACC.t >= len then ACC.finish() end
            end
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, faceYaw, 0)
            return true
        end
        -- squished flat
        if ACC.mode == "Squish" then
            ACC.t += dt
            humanoid:Move(Vector3.zero, false)
            humanoid.WalkSpeed = 0.01
            local t, k = ACC.t, 1
            if t < 0.12 then k = t / 0.12
            elseif t > 0.9 then k = math.max(0, 1 - (t - 0.9) / 0.35) end
            accSquash(1 + 0.35 * k, 1 - 0.62 * k)
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, faceYaw, 0)
            if t >= 1.25 then
                accSquash(1, 1)
                ACC.finish()
            end
            return true
        end
        -- a new hit (health went down)
        if ACC.hit then
            local h = ACC.hit
            ACC.hit = nil
            if now - h.t < 0.5 and now >= ACC.hitCool and state ~= "Swim" then
                ACC.hitCool = now + 0.6
                accKnock(h.dmg / humanoid.MaxHealth, accFindSource(), nil)
                return true
            end
        end
        -- shoved hard without taking damage (explosion, fling, someone pushing him)
        local hvNow = flat(v)
        if ACC.lastV and now >= ACC.extCool and ACC_PUSHABLE[state] and stateTime > 0.15 and launchGrace <= 0 then
            if hvNow.Magnitude > CFG.RunMax * 1.1 and (hvNow - ACC.lastV).Magnitude > math.max(CFG.RunMax * 1.6, 30) then
                ACC.extCool = now + 1
                accKnock(0.1, nil, v)
                ACC.lastV = flat(root.AssemblyLinearVelocity)
                return true
            end
        end
        ACC.lastV = hvNow
        -- crushed by a ceiling / something heavy coming down on him
        if fl and not AIR[state] and now >= ACC.cool and now >= ACC.crushScan then
            ACC.crushScan = now + 0.04
            local H = CFG.ModelHeight
            local feetY = y - rigFeet()
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = { character, marioModel }
            rp.RespectCanCollide = true
            local res = workspace:Raycast(Vector3.new(root.Position.X, feetY + 0.3, root.Position.Z), Vector3.new(0, H * 1.6, 0), rp)
            if res then
                local gap = res.Position.Y - feetY
                local part = res.Instance
                local closing = ACC.prevGap and (ACC.prevGap - gap) / math.max(now - ACC.prevT, 0.02) or 0
                ACC.prevGap, ACC.prevT = gap, now
                local pvy = part.AssemblyLinearVelocity.Y
                local crushed = false
                if gap < H * 0.62 and (closing > 4 or (not part.Anchored and pvy < -4)) then crushed = true
                elseif gap < H * 1.25 and not part.Anchored and pvy < -22 and part.AssemblyMass > 4 then crushed = true end
                if crushed then
                    ACC.prevGap = nil
                    ACC.startSquish(0.25, "crush")
                    return true
                end
            else
                ACC.prevGap = nil
            end
        end
        return false
    end
    local function dealHit(h, model, dmg, kind)
        if (shared.M64Opts or {}).combat == false then return end -- SM64 menu > Combat Mode is off: nobody gets hurt
        local target = _M.Players:GetPlayerFromCharacter(model)
        if target and target ~= player then
            local net = shared.M64Multiplayer
            if net and net.peers[target] and net.peers[target].mario then
                net.sendAttack(target, dmg, kind)
            end
            return
        end
        local remote = _M.ReplicatedStorage:FindFirstChild("MarioHit")
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(h, kind, dmg)
        else
            h:TakeDamage(dmg)
        end
        local hrp = model:FindFirstChild("HumanoidRootPart")
        if hrp then
            local push = flat(hrp.Position - root.Position)
            if push.Magnitude > 0.1 then
                hrp.AssemblyLinearVelocity = push.Unit * 40 + Vector3.new(0, 30, 0)
            end
        end
    end
    -- SM64 numbers: Mario's hurtbox is a cylinder of radius 37 and height 160 (SM64 units).
    -- 160 SM64 units = CFG.ModelHeight studs. Attacks hit anything whose hurtbox touches Mario's
    -- radius + a short attack reach, inside a forward arc (like the real game's attack-angle check).
    _M.ATTACK = {
        punch = { 40, 60 }, kick = { 40, 60 }, slide = { 40, 100 }, air = { 40, 100 }, dive = { 40, 100 }, pound = { 110, 360 }, breakdance = { 55, 360 },
    }
    local HB = { h = 160 }
    local function hitbox(_center, _radius, dmg, kind, ruleKind)
        local u = CFG.ModelHeight / 160
        if HB.flash then pcall(HB.flash, kind) end
        local rule = _M.ATTACK[ruleKind or kind] or _M.ATTACK[kind] or { 40, 90 }
        local reach = 37 * u + rule[1] * u
        local mpos = root.Position
        local feetY = mpos.Y - rigFeet()
        local topY = feetY + HB.h * u
        local fwd = dirOf(faceYaw)
        local seen = {}
        for _, p in ipairs(workspace:GetPartBoundsInRadius(mpos, reach + 8, overlapParams)) do
            local m = p:FindFirstAncestorOfClass("Model")
            if m and not seen[m] then
                seen[m] = true
                local h = m:FindFirstChildOfClass("Humanoid")
                local hrp = m:FindFirstChild("HumanoidRootPart")
                if h and hrp and h.Health > 0 and not hitSet[h] and m ~= character then
                    local cf, size = m:GetBoundingBox()
                    local tr = math.min(math.max(hrp.Size.X, hrp.Size.Z) / 2, 2)
                    local d = flat(hrp.Position - mpos)
                    local dist = d.Magnitude
                    local lowY, highY = cf.Position.Y - size.Y / 2, cf.Position.Y + size.Y / 2
                    local inArc = rule[2] >= 360 or dist < 0.2 or math.acos(math.clamp(fwd:Dot(d.Unit), -1, 1)) <= math.rad(rule[2])
                    if dist <= reach + tr and lowY <= topY and highY >= feetY and inArc then
                        hitSet[h] = true
                        dealHit(h, m, dmg, kind)
                    end
                end
            end
        end
    end
    local function front(dist) return root.Position + dirOf(faceYaw) * dist end
    local lastLJ, ljDir, ljBack = -10, 0, false
    local ljFace, bljSpeed, bljStuck = 0, CFG.LongJumpSpeed, false
    -- net gravity Mario feels while he is in the air. Normally GravityScale x the game's own Workspace.Gravity, so a game with strong
    -- gravity made every jump lower. With "Same Jump Gravity" on (default) it is always GravityScale x 196.2 (Roblox's default),
    -- so single / double / triple jumps reach the same height and distance in every game.
    CFG.NetG = function()
        local o = shared.M64Opts
        if o and o.fixedGravity == false then return CFG.GravityScale * workspace.Gravity end
        return CFG.GravityScale * 196.2
    end
    local function launch(kind, vy, newHv, face)
        hv = newHv
        if face then faceYaw = face end
        root.AssemblyLinearVelocity = Vector3.new(hv.X, vy, hv.Z)
        launchGrace = 0.12
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        setState(kind)
        jumpCut = false
        eat("jump")
        local an = AIR_ANIM[kind] or "general_fall"
        local sp = 1
        if _M.FIT[kind] then
            sp = math.clamp(trackLength(an, 1) / math.max(2 * vy / CFG.NetG(), 0.2), 0.6, 2)
        end
        play(an, sp, 0.05)
    end
    -- lava boost (SM64): touching lava throws Mario high into the air, burning, then he lands hurt
    CFG.LavaCheck = function()
        local now = os.clock()
        if state == "LavaBoost" or now < (CFG.LavaCD or 0) or humanoid.Health <= 0 then return end
        if now - (CFG.LavaScan or 0) < 0.08 then return end
        CFG.LavaScan = now
        local function isLava(p)
            if not p or not p:IsA("BasePart") then return false end
            if p.Material == Enum.Material.CrackedLava then return true end
            local n = string.lower(p.Name)
            return string.find(n, "lava", 1, true) ~= nil or string.find(n, "magma", 1, true) ~= nil
        end
        local hot = false
        local res = workspace:Raycast(root.Position, Vector3.new(0, -(rigFeet() + 1.2), 0), rayParams)
        if res and isLava(res.Instance) then hot = true end
        if not hot then
            for _, p in ipairs(workspace:GetPartBoundsInRadius(root.Position, CFG.ModelHeight * 0.5, overlapParams)) do
                if isLava(p) then hot = true break end
            end
        end
        if not hot then return end
        CFG.LavaCD = now + 2
        local g = math.max(CFG.NetG(), 1)
        launch("LavaBoost", math.sqrt(2 * g * CFG.ModelHeight * 4), Vector3.zero, faceYaw)
        if CFG.LavaFire then pcall(function() CFG.LavaFire:Destroy() end) end
        local f = Instance.new("Fire")
        f.Size = 8; f.Heat = 6
        f.Parent = root
        CFG.LavaFire = f
        task.delay(3, function() if f.Parent then f:Destroy() end end)
    end
    local function doJump()
        local dirv = dirOf(moveYaw)
        local mvIn, mgIn = getMove()
        -- right after a long jump the direction you HOLD decides: back = backwards long jump, forward = long jump again, nothing held = a normal jump
        local afterLJ = os.clock() - lastLJ < 0.9 and (state == "Land" or state == "Crouch" or state == "Crawl")
        local ljDot = mgIn > 0.1 and mvIn:Dot(dirOf(ljFace)) or 0
        if _M.ljHold then
            -- Z + A held after a long jump: with nothing (or a sideways push) held, keep the same kind of long jump going
            _M.ljHold = false
            if math.abs(ljDot) <= 0.5 then ljDot = ljBack and -1 or 1 end
        end
        if afterLJ and ljDot < -0.5 then
            -- backwards long jump: keep facing the long-jump direction, travel the opposite way
            ljBack = true
            if bljStuck then bljSpeed = math.min(CFG.BLJMax, bljSpeed * CFG.BLJGrow + CFG.BLJAdd) else bljSpeed = CFG.LongJumpSpeed end
            bljStuck = false
            launch("LongJump", CFG.LongJumpV, -dirOf(ljFace) * bljSpeed, ljFace)
            play("slow_longjump", 1, 0.05)
            return
        elseif afterLJ and ljDot > 0.5 then
            -- forward again: another long jump the way you were going
            ljBack, bljStuck = false, false
            launch("LongJump", CFG.LongJumpV, dirOf(ljFace) * math.max(fVel, CFG.LongJumpSpeed), ljFace)
            return
        end
        if state == "Crouch" or state == "Crawl" then
            if fVel > CFG.LongJumpMin then
                ljBack = false
                ljFace, bljStuck = moveYaw, false
                launch("LongJump", CFG.LongJumpV, dirv * math.max(fVel, CFG.LongJumpSpeed), moveYaw)
            else
                launch("Backflip", CFG.BackflipV, -dirOf(faceYaw) * CFG.BackflipBack, faceYaw)
            end
        elseif state == "Skid" then
            launch("SideFlip", CFG.SideFlipV, dirOf(skidFace) * CFG.SideFlipSpeed, skidFace + math.pi) -- faces backwards: the flip turns backwards
        else
            local n = 1
            if os.clock() - lastLand < CFG.ChainWindow then
                n = chainAfter + 1
                if chainAfter == 3 then n = ((shared.M64Opts or {}).gpJump == true) and 3 or 1 -- ground pound jump: only when the menu toggle is ON, otherwise a normal jump like SM64
                elseif n == 3 and fVel < CFG.TripleMin and player:GetAttribute("M64Wing") ~= true then n = 2 end -- with the wing cap the triple jump works in place
            end
            local fwd = dirv * fVel * 0.92
            if n == 1 then launch("Jump", CFG.JumpV, fwd, faceYaw)
            elseif n == 2 then launch("DoubleJump", CFG.DoubleV, fwd, faceYaw)
            else launch("TripleJump", CFG.TripleV, fwd * 1.1, faceYaw) end
        end
    end
    local function onLand()
        local from = state
        if ACC.onLand and ACC.onLand(from) then return end
        diveCancelT = 0
        local h = flat(hv)
        moveYaw = h.Magnitude > 1 and yawOf(h) or faceYaw
        fVel = h.Magnitude
        hv = Vector3.zero
        lastLand = os.clock()
        chainAfter = (from == "Jump" and 1) or (from == "DoubleJump" and 2) or (from == "GroundPound" and 3) or 0
        landAnim, landLock, landFreeze, landFriction = "general_land", 0.12, false, 80
        if from == "Jump" then landAnim = "land_from_single_jump"
        elseif from == "DoubleJump" then landAnim = "land_from_double_jump"
        elseif from == "WallKick" then
            landAnim = "wall_kick_land"
        elseif from == "SideFlip" then
            landAnim, landLock, landFreeze, landFriction = "general_land", math.max(0.45, trackLength("general_land", 0.75) * 0.98), true, 60
            fVel = fVel * 0.3
        elseif from == "TripleJump" or from == "Fly" then
            landAnim, landLock, landFreeze = "triple_jump_land", 0.5, true
            fVel = fVel * 0.4
        elseif from == "Backflip" then
            landAnim, landLock, landFreeze = "backflip_land", 0.4, true
            fVel = 0
        elseif from == "LongJump" then
            lastLJ, ljDir = os.clock(), ljFace
            landAnim, landLock, landFriction = "crouch_from_fast_longjump", 0.55, 30
            fVel = fVel * 0.75
            if ljBack then
                if stateTime < 0.25 then bljStuck = true end -- landed almost at once (low ceiling / stairs): keep building speed
                fVel = 0
            end
        elseif from == "LavaBoost" then
            landAnim, landLock, landFreeze = "lava_land", 0.55, true
            fVel = 0
            if CFG.LavaFire then pcall(function() CFG.LavaFire:Destroy() end); CFG.LavaFire = nil end
        elseif from == "Dive" then
            fVel = math.min(fVel, 34)
            setState("DiveSlide")
            play("dive_hold", 1, 0.05)
            return
        elseif from == "GroundPound" then
            landAnim, landLock, landFreeze = "ground_pound_landing", 0.5, true
            fVel = 0
            setState("Land")
            hitbox(root.Position, 9, CFG.Damage.pound, "pound")
            play(landAnim, 1, 0.03)
            return
        end
        if not landFreeze then landLock = math.max(landLock, math.min(0.6, trackLength(landAnim, 0) * 0.85)) end
        setState("Land")
        play(landAnim, 1, 0.03)
    end
    local carried, carryWeld, carryInfo = nil, nil, nil
    ACC.carriedGet = function() return carried end
    local function isNPC(m)
        if not m or m == character then return false end
        if _M.Players:GetPlayerFromCharacter(m) then return false end
        local h = m:FindFirstChildOfClass("Humanoid")
        return h ~= nil and h.Health > 0 and m:FindFirstChild("HumanoidRootPart") ~= nil
    end
    local function releaseCarried(vel)
        if not carried then return end
        local m, info = carried, carryInfo
        carried, carryInfo = nil, nil
        CFG.Carry = false
        if carryWeld then carryWeld:Destroy(); carryWeld = nil end
        pcall(function() m:SetAttribute("M64Held", nil) end)
        if m.Parent then
            for part, v in pairs(info.parts) do
                if part.Parent then part.CanCollide = v.cc; part.Massless = v.ms end
            end
            local hrp = m:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Anchored = info.anch
                hrp.AssemblyLinearVelocity = vel or Vector3.zero
            end
            local h = m:FindFirstChildOfClass("Humanoid")
            if h then
                h.PlatformStand = info.ps
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end
    end
    local function grabNearest()
        local best, bd = nil, 99
        for _, part in ipairs(workspace:GetPartBoundsInRadius(front(2.2), 4.5, overlapParams)) do
            local m = part:FindFirstAncestorOfClass("Model")
            if m and isNPC(m) then
                local d = (m.HumanoidRootPart.Position - root.Position).Magnitude
                if d < bd then best, bd = m, d end
            end
        end
        if not best then return false end
        local hrp = best.HumanoidRootPart
        local h = best:FindFirstChildOfClass("Humanoid")
        local info = { parts = {}, anch = hrp.Anchored, ps = h.PlatformStand }
        for _, d in ipairs(best:GetDescendants()) do
            if d:IsA("BasePart") then
                info.parts[d] = { cc = d.CanCollide, ms = d.Massless }
                d.CanCollide = false; d.Massless = true
            end
        end
        h.PlatformStand = true
        pcall(function() best:SetAttribute("M64Held", true) end)
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = root.CFrame * CFrame.new(0, CFG.ModelHeight * 0.85, 0)
        local w = Instance.new("WeldConstraint")
        w.Part0 = root; w.Part1 = hrp; w.Parent = hrp
        carried, carryWeld, carryInfo = best, w, info
        CFG.Carry = true
        return true
    end
    local function throwCarried()
        if not carried then return end
        releaseCarried(dirOf(faceYaw) * 55 + Vector3.new(0, 28, 0))
        play("throw_npc", 1.1, 0.04)
    end
    local function toggleCarry()
        if carried then
            releaseCarried(dirOf(faceYaw) * 6)
            play("hold_release", 1, 0.05)
        elseif state == "Idle" or state == "Walk" then
            grabNearest()
        end
    end
    local function startAttack()
        eat("attack")
        if carried then throwCarried() return end
        -- a dive (in the air, fast enough) or a slide kick (running fast) always wins, also with an item in the hand
        local canMove = (state == "Walk" and fVel >= CFG.SlideKickMin)
        or (AIR[state] and state ~= "AirKick" and state ~= "Dive" and state ~= "GPStart" and state ~= "GroundPound" and state ~= "AirBonk" and flat(hv).Magnitude >= CFG.DiveMinSpeed)
        if not canMove then
            if _M.useHeldItem and _M.useHeldItem() then return end -- holding an item: B uses it
            -- (no item in the hand: B only punches / kicks. It no longer presses a game button, which sometimes was the Emote button.)
        end
        if state == "Idle" or state == "Walk" then
            if state == "Walk" and fVel >= CFG.SlideKickMin then
                fVel = math.max(fVel, CFG.SlideKickSpeed)
                faceYaw = moveYaw
                setState("SlideKick")
                play("slide_kick", 1, 0.04)
            else
                comboQueued = false
                setState("Punch1")
                fVel = CFG.PunchLunge
                moveYaw = faceYaw
                play(carried and "hold_attack" or "first_punch", 1.2, 0.04)
            end
        elseif AIR[state] and state ~= "AirKick" and state ~= "Dive" and state ~= "GPStart"
            and state ~= "GroundPound" and state ~= "AirBonk" then
            local speed = flat(hv).Magnitude
            if speed >= CFG.DiveMinSpeed then
                local d = flat(hv).Unit
                launch("Dive", CFG.DiveV, d * math.max(speed, CFG.DiveSpeed), yawOf(d))
            else
                local saved = hv
                local vy = root.AssemblyLinearVelocity.Y
                setState("AirKick")
                hv = saved
                root.AssemblyLinearVelocity = Vector3.new(hv.X, math.max(vy, 8), hv.Z)
                play("air_kick", 1.9, 0.04)
            end
        end
    end
    -- BREAKDANCE ATTACK: crouch (hold) + punch = Mario spins on the floor and sweeps his legs all around him
    local bdSeg = 1
    local function startBreakdance()
        eat("attack")
        bdSeg = 1
        if carried then throwCarried() return end
        setState("Breakdance")
        fVel = math.min(fVel, 6)
        play("breakdance", 1.15, 0.05)
    end
    local skidIsBrake = false
    local function locomote(dt, mag, wantYaw, maxSpeed, friction)
        local skid = false
        if wantYaw then
            local d = angDiff(moveYaw, wantYaw)
            if state == "Walk" and fVel > CFG.SkidSpeed and math.abs(d) > math.rad(115) then
                skid = true
                skidIsBrake = false -- turning around: BD
                skidFace = wantYaw
            else
                local turn = math.rad(lerp(CFG.TurnSlow, CFG.TurnFast, math.clamp(fVel / CFG.RunMax, 0, 1))) * dt
                local stepYaw = math.clamp(d, -turn, turn)
                moveYaw += stepYaw
                turnRate = stepYaw / dt
                local target = maxSpeed * mag
                if fVel < target then
                    fVel = math.min(target, fVel + CFG.Accel * dt * (1.6 - fVel / math.max(maxSpeed, 1)))
                else
                    fVel = math.max(target, fVel - friction * dt)
                end
            end
        else
            turnRate = 0
            if state == "Walk" and fVel > CFG.BrakeSkidSpeed then
                skid = true
                skidIsBrake = true -- braking to a stop: 0F
                skidFace = moveYaw
            end
            fVel = math.max(0, fVel - friction * dt)
        end
        faceYaw = moveYaw
        return skid
    end
    local function wallRay(dir, len)
        local res = workspace:Raycast(root.Position, dir * len, rayParams)
        if res and math.abs(res.Normal.Y) < 0.35 then return res end
        return nil
    end
    -- pushing: walking into a wall plays the push animation; loose parts in front get shoved out of the way
    CFG.PushSpeed = 6
    CFG.PushCheck = function(wy)
        if not wy or humanoid.FloorMaterial == Enum.Material.Air then return false end
        local d = dirOf(wy)
        local res = workspace:Raycast(root.Position, d * 2.4 * (CFG.WallR or 1), rayParams)
        if not res or math.abs(res.Normal.Y) > 0.5 then return false end
        local n = flat(res.Normal)
        if n.Magnitude < 0.1 or d:Dot(-n.Unit) < 0.3 then return false end
        local p = res.Instance
        local loose = false
        if p and not p.Anchored then
            local mdl = p:FindFirstAncestorOfClass("Model")
            if p.AssemblyMass < 800 and not (mdl and mdl:FindFirstChildOfClass("Humanoid")) then
                loose = true
                local v = p.AssemblyLinearVelocity
                if flat(v).Magnitude < 7 then p.AssemblyLinearVelocity = Vector3.new(d.X * 7, v.Y, d.Z * 7) end
            end
        end
        if not loose and flat(root.AssemblyLinearVelocity).Magnitude > 4.5 then return false end
        fVel = math.min(fVel, CFG.PushSpeed) -- pushing never builds speed, so it can't turn into a bonk
        return true
    end
    -- walking into a wall at an angle (or with the stick pushed a little left / right): he slides along the wall instead of just pushing
    CFG.WallSlide = function(wy)
        if not wy or humanoid.FloorMaterial == Enum.Material.Air then return nil end
        local d = dirOf(wy)
        local reach = 37 * CFG.ModelHeight / 160 * (CFG.WallR or 1) + 0.6
        local res = workspace:Raycast(root.Position, d * reach, rayParams)
        if not res or not res.Instance.CanCollide or math.abs(res.Normal.Y) > 0.5 then return nil end
        local n = flat(res.Normal)
        if n.Magnitude < 0.1 then return nil end
        n = n.Unit
        local into = d:Dot(-n) -- 1 = straight into the wall, 0 = along it
        if into < 0.05 then return nil end
        local t = d + n * into -- the stick direction with the part that points into the wall taken out
        if t.Magnitude < 0.12 then return nil end -- straight into the wall: just push
        return yawOf(t.Unit), t.Magnitude
    end
    -- SM64: only launched moves bonk on the ground: belly slide (after a dive) and slide kick
    local function groundWallBonk()
        if fVel < 14 then return false end
        local hit = wallRay(dirOf(moveYaw), 2.7)
        if hit and flat(hit.Normal).Magnitude > 0.1 and dirOf(moveYaw):Dot(-flat(hit.Normal).Unit) > 0.7 then
            faceYaw = moveYaw
            fVel = 16
            setState("Bonk")
            play("ground_bonk", 1.6, 0.03)
            return true
        end
        return false
    end
    local slideBlock, slideAng = 0, 0
    local ledgeBlock, ledgeNormal, ledgeRoot, ledgeOrigin, ledgeFast = 0, Vector3.zero, Vector3.zero, Vector3.zero, true
    local function feetOffset()
        return rigFeet()
    end
    CFG.StairMax = CFG.ModelHeight * 0.45 -- tallest step he climbs just by walking (studs)
    CFG.StairAngle = 55 -- a slope up to this steep, walked on with the stick held, counts as stairs (no slide)
    local function stairsOn() return (shared.M64Opts or {}).stairs ~= false end
    local function stairName(p)
        local cur, n = p, 0
        while cur and cur ~= workspace and n < 4 do
            local nm = string.lower(cur.Name)
            if string.find(nm, "stair", 1, true) or string.find(nm, "step", 1, true) or string.find(nm, "escal", 1, true) or string.find(nm, "escad", 1, true) then return true end
            cur = cur.Parent
            n += 1
        end
        return false
    end
    -- true = this steep floor is a staircase, so no slide
    CFG.StairsHere = function(fh, wy, fd)
        if not stairsOn() then return false end
        if stairName(fh.Instance) then return true end
        if wy and state == "Walk" and dirOf(wy):Dot(fd) < 0.2 and fh.Normal.Y > math.cos(math.rad(CFG.StairAngle)) then return true end
        return false
    end
    -- walking into a low riser: lift him onto the step (the game's own stepping is not enough for a small model)
    CFG.StairAssist = function(wy)
        if not wy or fVel < 2 or not stairsOn() then return end
        local pos = root.Position
        local feetY = pos.Y - feetOffset()
        local d = dirOf(wy)
        local low = workspace:Raycast(Vector3.new(pos.X, feetY + 0.3, pos.Z), d * 1.7 * (CFG.WallR or 1), rayParams)
        if not low or not low.Instance.CanCollide or math.abs(low.Normal.Y) > 0.5 then return end
        local n = flat(low.Normal)
        if n.Magnitude < 0.1 or d:Dot(-n.Unit) < 0.3 then return end
        local probe = low.Position + d * 0.45
        local reach = CFG.StairMax + 0.25
        local top = workspace:Raycast(Vector3.new(probe.X, feetY + reach, probe.Z), Vector3.new(0, -(reach + 0.2), 0), rayParams)
        if not top or not top.Instance.CanCollide or top.Normal.Y < 0.7 then return end
        local rise = top.Position.Y - feetY
        if rise < 0.12 or rise > CFG.StairMax then return end
        -- room for his body on top of the step
        if workspace:Raycast(Vector3.new(probe.X, top.Position.Y + 0.05, probe.Z), Vector3.new(0, CFG.ModelHeight * 0.95, 0), rayParams) then return end
        local v = root.AssemblyLinearVelocity
        root.CFrame = root.CFrame + Vector3.new(0, math.min(rise + 0.05, 0.9), 0)
        root.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
    end
    local function tryLedge()
        local H, fo = CFG.ModelHeight, feetOffset()
        local pos = root.Position
        local feetY = pos.Y - fo
        local d = dirOf(faceYaw)
        local wall = workspace:Raycast(Vector3.new(pos.X, feetY + H * 0.5, pos.Z), d * 2.2, rayParams)
        if not wall or math.abs(wall.Normal.Y) > 0.3 then return false end
        local n = flat(wall.Normal)
        if n.Magnitude < 0.1 then return false end
        n = n.Unit
        if n:Dot(d) > -0.5 then return false end
        local spot = wall.Position - n * 0.6
        local down = workspace:Raycast(Vector3.new(spot.X, feetY + H * 1.05, spot.Z), Vector3.new(0, -H * 0.46, 0), rayParams)
        if not down or down.Normal.Y < 0.9 then return false end
        if workspace:Raycast(down.Position + Vector3.new(0, 0.2, 0), Vector3.new(0, H * 0.9, 0), rayParams) then return false end
        ledgeNormal, ledgeOrigin = n, down.Position
        ledgeRoot = down.Position + Vector3.new(0, fo + 0.1, 0)
        faceYaw = yawOf(-n)
        moveYaw = faceYaw
        hv = Vector3.zero
        fVel = 0
        root.CFrame = CFrame.new(ledgeRoot) * CFrame.Angles(0, faceYaw, 0)
        root.AssemblyLinearVelocity = Vector3.zero
        setState("Ledge")
        play("ledge_idle", 1, 0.05)
        return true
    end
    local function letGoLedge()
        local rp = ledgeOrigin + ledgeNormal * 1.2 + Vector3.new(0, feetOffset() - CFG.ModelHeight * 0.9, 0)
        root.CFrame = CFrame.new(rp) * CFrame.Angles(0, faceYaw, 0)
        ledgeBlock = os.clock() + 0.5
        launch("Fall", 0, ledgeNormal * 3)
    end
    local FXS = { wing = not PK.netpeer and player:GetAttribute("M64Wing") == true, metal = not PK.netpeer and player:GetAttribute("M64Metal") == true, gliding = false, wasGliding = false, lastFlap = -10,
        glide = {} } -- no free gliding on ordinary jumps: like the game, the wing cap only flies after a TRIPLE jump (state "Fly")
    local NOPITCH = { LongJump = true, AirKick = true, GPStart = true, GroundPound = true, Backflip = true, TripleJump = true, SideFlip = true, AirBonk = true, WallKick = true }
    local function step(dt)
        if carried then
            local ch = carried:FindFirstChildOfClass("Humanoid")
            if not carried.Parent or not ch or ch.Health <= 0 or humanoid.Health <= 0 then releaseCarried(Vector3.zero) end
        end
        if grabRequest then grabRequest = false; toggleCarry() end
        if dead then return end
        dt = math.min(dt, 0.05)
        if debugMode then
            humanoid:Move(Vector3.zero, false)
            humanoid.WalkSpeed = 0.01
            return
        end
        if _M.SP.pending then
            _M.SP.pending = false
            if (shared.M64Opts or {}).spawnAnim ~= false and humanoid.Health > 0 then
                local H = CFG.ModelHeight
                local up = H * _M.SP.height
                local hit = workspace:Raycast(root.Position, Vector3.new(0, up + H, 0), rayParams)
                if hit then up = hit.Distance - H * 1.5 end -- low ceiling: start lower
                if up >= H * 2 then
                    root.CFrame = root.CFrame + Vector3.new(0, up, 0)
                    root.AssemblyLinearVelocity = Vector3.zero
                    hv, fVel = Vector3.zero, 0
                    launchGrace = 0.2
                    _M.spawnFall = true
                    _M.SP.spin = true
                    setState("Fall")
                    diveSpinT = 99 -- keep the spin animation until he lands
                    _M.LOOPED.spin = true -- loop the spin while he falls
                    play("spin", 1, 0.04)
                end
            end
        end
        if _M.SP.spin then
            if state ~= "Fall" or humanoid.Health <= 0 then
                _M.SP.spin = false
                _M.spawnFall = false
                _M.LOOPED.spin = nil
                diveSpinT = 0
            else
                faceYaw += math.rad(_M.SP.rate) * dt
            end
        end
        do
            local okA, handled = pcall(ACC.step, dt)
            if not okA and not ACC.warned then ACC.warned = true; warn("[Mario64] accuracy error: " .. tostring(handled)) end
            if okA and handled then return end
        end
        stateTime += dt
        if CFG.LavaCheck then pcall(CFG.LavaCheck) end
        local t = os.clock()
        local cur = root.AssemblyLinearVelocity
        local move, mag = getMove()
        local wantYaw = mag > 0.1 and yawOf(move) or nil
        if launchGrace > 0 then launchGrace -= dt end
        local floor = humanoid.FloorMaterial ~= Enum.Material.Air and launchGrace <= 0
        if floor then airTime = 0 else airTime += dt end
        local swimming = humanoid:GetState() == Enum.HumanoidStateType.Swimming
        if swimming and state ~= "Swim" then
            hv = Vector3.zero
            fVel = 0
            setState("Swim")
        elseif not swimming and state == "Swim" then
            setState("Idle")
        end
        if AIR[state] then
            if floor and cur.Y < 5 then onLand() end
        elseif not floor and airTime > 0.12 and state ~= "Bonk" and state ~= "Swim" and state ~= "Ledge" and state ~= "LedgeClimb" then
            hv = dirOf(moveYaw) * fVel
            setState("Fall")
            play("general_fall")
        end
        if AIR[state] then
            humanoid:Move(Vector3.zero, false)
            local vy = cur.Y
            if diveCancelT > 0 then
                diveCancelT -= dt
                faceYaw = diveCancelYaw
            end
            if diveSpinT > 0 then
                diveSpinT -= dt
                if state ~= "Fall" then diveSpinT = 0
                elseif diveSpinT <= 0 then play("general_fall", 1, 0.1) end
            end
            if fresh("crouch") and state ~= "GPStart" and state ~= "GroundPound" and state ~= "AirBonk" then
                eat("crouch")
                hv = Vector3.zero
                local flying = state == "TripleJump"
                setState("GPStart")
                play(flying and "start_ground_pound_flying" or "start_ground_pound", 1, 0.04)
                vy = 0
            end
            if fresh("attack") then startAttack() end
            -- a dive cancel needs a NEW jump press: a jump that is still held (or was used to start the dive) must not cancel it
            if state ~= "Dive" then _M.diveArm = nil
            elseif stateTime < 0.05 or _M.diveArm == nil then _M.diveArm = not jumpHeld()
            elseif not _M.diveArm and not jumpHeld() then _M.diveArm = true end
            if state == "Dive" and _M.diveArm and fresh("jump", 0.3) and stateTime > 0.1 then
                eat("jump")
                -- clean dive cancel: keep facing + momentum, stand back up smoothly (no snap-turn)
                diveCancelT, diveCancelYaw = 0.5, faceYaw
                setState("Fall")
                bodyPitch = 0 -- drop the dive tilt at once
                diveSpinT = 0.4
                play("spin", 1, 0.04) -- SM64 spinning animation (0x70) on a dive cancel
            end
            vy = state == "GPStart" and 0 or root.AssemblyLinearVelocity.Y
            if state == "GPStart" then
                hv = Vector3.zero
                vy = 0
                if stateTime >= (sm64Gravity and 0.37 or CFG.GPHover) then
                    setState("GroundPound")
                end
            elseif state == "GroundPound" then
                hv = Vector3.zero
                vy = sm64Gravity and -(50 * 30 * CFG.ModelHeight / 160) or -CFG.GPSpeed
            else
                if not _M.NO_STEER[state] and diveCancelT <= 0 then
                    if wantYaw then
                        hv += move * CFG.AirAccel * mag * dt
                        local s = hv.Magnitude
                        if s > CFG.AirMax and s > 0 then
                            hv = hv.Unit * math.max(CFG.AirMax, s - 30 * dt)
                        end
                    else
                        hv *= (1 - math.min(CFG.AirDrag * dt, 1))
                    end
                end
                if state == "LongJump" and diveCancelT <= 0 then
                    -- long jump: facing stays locked; slowly steering the movement backwards turns it into a BLJ
                    local cur = flat(hv)
                    local sp = cur.Magnitude
                    if wantYaw and sp > 1 then
                        local cy = yawOf(cur)
                        local d = angDiff(cy, wantYaw)
                        local lim = math.rad(110) * mag * dt
                        hv = dirOf(cy + math.clamp(d, -lim, lim)) * sp
                    end
                    local dotv = flat(hv):Dot(dirOf(ljFace))
                    if not ljBack and dotv < -2 then
                        ljBack = true
                        bljSpeed, bljStuck = math.max(CFG.LongJumpSpeed, flat(hv).Magnitude), false
                        play("slow_longjump", 1, 0.15)
                    elseif ljBack and dotv > 2 then
                        ljBack = false
                        play(AIR_ANIM.LongJump, 1, 0.15)
                    end
                    faceYaw = ljFace
                    if ljBack and workspace:Raycast(root.Position, Vector3.new(0, CFG.ModelHeight * CFG.BLJCeil, 0), rayParams) then
                        bljStuck = true -- head under a low ceiling: short hops, speed keeps stacking
                    end
                end
                if sm64Gravity then
                    local U = CFG.ModelHeight / 160
                    local g = ((state == "LongJump") and 2 or 4) * 900 * U
                    vy = math.max(vy + (workspace.Gravity - g) * dt, -75 * 30 * U)
                else
                    vy += (workspace.Gravity - CFG.NetG()) * dt
                end
                if (state == "Jump" or state == "DoubleJump") and vy > 0 and not jumpCut and not jumpHeld() and (shared.M64Opts or {}).varJump == true then
                    vy *= 0.45
                    jumpCut = true
                end
                if state == "DoubleJump" and vy < 0 and not FXS.gliding then play("double_jump_fall") end
                if state == "AirKick" and stateTime > 0.45 then setState("Fall"); play("general_fall") end
            end
            if state == "AirKick" then hitbox(front(2.5), 3.6, CFG.Damage.air, "air") end
            if state == "Dive" then hitbox(front(2.2), 3.4, CFG.Damage.dive, "dive") end
            local hs = flat(hv)
            if state ~= "GPStart" and state ~= "GroundPound" then
                local dir = hs.Magnitude > 3 and hs.Unit or dirOf(faceYaw)
                local hit = wallRay(dir, 2.7)
                if hit then
                    lastWall, wallNormal = t, flat(hit.Normal).Unit
                    if state == "LongJump" and ljBack then bljStuck = true end
                    if state == "Dive" or (state == "LongJump" and not ljBack and hs.Magnitude > 30) then
                        hv = wallNormal * 9
                        vy = 0
                        setState("AirBonk")
                        play("backward_air_kb", 1.5, 0.03)
                    else
                        hv = hs - hs:Dot(wallNormal) * wallNormal
                    end
                end
                if fresh("jump") and t - lastWall < 0.22 and wallNormal.Magnitude > 0 and not (state == "LongJump" and ljBack) then
                    launch("WallKick", CFG.WallKickV, wallNormal * CFG.WallKickSpeed, yawOf(wallNormal))
                    vy = CFG.WallKickV
                end
            end
            if t > ledgeBlock and vy <= 0 and AIR[state] and not carried and state ~= "Dive" and state ~= "GPStart" and state ~= "GroundPound" and state ~= "AirBonk" and state ~= "AirKick" and not (state == "LongJump" and ljBack) then
                if tryLedge() then vy = 0 end
            end
            local hs2 = flat(hv)
            if not _M.KEEP_FACE[state] and state ~= "LongJump" and hs2.Magnitude > 2 and diveCancelT <= 0 then
                local d = angDiff(faceYaw, yawOf(hs2))
                faceYaw += math.clamp(d, -math.rad(720) * dt, math.rad(720) * dt)
            end
            if state == "TripleJump" and FXS.wing and not carried and stateTime > 0.4 and not _M.NOFLY then
                -- wing cap + triple jump = take off into flight
                setState("Fly")
                flySpeed = math.max(CFG.RunMax * 2.0, flat(hv).Magnitude)
                flyPitch = math.rad(12)
                flyFlap = t
                play("flying", 1, 0.1)
            end
            FXS.gliding = false
            if FXS.wing and not carried and FXS.glide[state] and stateTime > 0.18 and vy < 8 and jumpHeld() then
                FXS.gliding = true
                if fresh("jump") and t - FXS.lastFlap > 0.4 then
                    eat("jump")
                    FXS.lastFlap = t
                    vy = 26
                    if FXS.onFlap then FXS.onFlap() end
                end
                vy = math.max(vy, -14)
                hv += dirOf(faceYaw) * 45 * dt
                local gs = flat(hv)
                local gcap = CFG.RunMax * 1.15
                if gs.Magnitude > gcap then hv = gs.Unit * gcap end
                play("flying", 1, 0.15)
            elseif FXS.wasGliding and AIR[state] then
                play("general_fall", 1, 0.15)
            end
            if state == "Fly" then
                -- FLIGHT: stick up = dive (speed up), stick down = climb (speed down), stick sideways = bank and turn, hold jump = flap to sink slower
                if not FXS.wing or carried or humanoid.Health <= 0 then
                    setState("Fall")
                    play("general_fall", 1, 0.15)
                else
                    FXS.gliding = true
                    local fwdIn = mag > 0.1 and move:Dot(dirOf(faceYaw)) * mag or 0
                    local sideIn = mag > 0.1 and move:Dot(dirOf(faceYaw - math.pi / 2)) * mag or 0
                    faceYaw -= sideIn * math.rad(95) * dt
                    local target
                    if fwdIn > 0.15 then target = -math.rad(60) * fwdIn
                    elseif fwdIn < -0.15 then target = math.rad(48) * -fwdIn
                    else target = -math.rad(6) end
                    local vmin, vmax = CFG.RunMax * 1.25, CFG.RunMax * 4.2
                    if flySpeed <= vmin * 1.03 and target > 0 then target = -math.rad(8) end -- too slow to keep climbing: the nose drops
                    flyPitch += math.clamp(target - flyPitch, -math.rad(110) * dt, math.rad(110) * dt)
                    flySpeed = math.clamp(flySpeed - math.sin(flyPitch) * CFG.RunMax * 1.9 * dt - (flySpeed - CFG.RunMax * 2) * 0.08 * dt, vmin, vmax)
                    local pe = flyPitch
                    if jumpHeld() then
                        if pe < 0 then pe *= 0.4 end -- flapping: a dive turns into a gentle glide
                        if fresh("jump") and t - flyFlap > 0.4 then
                            eat("jump"); flyFlap = t
                            if FXS.onFlap then FXS.onFlap() end
                        end
                    end
                    hv = dirOf(faceYaw) * (flySpeed * math.cos(pe))
                    vy = flySpeed * math.sin(pe)
                    if jumpHeld() and t - flyFlap < 0.25 then vy += CFG.RunMax * 0.6 end
                    play("flying", 1, 0.15)
                end
            end
            FXS.wasGliding = FXS.gliding
            root.AssemblyLinearVelocity = Vector3.new(hv.X, vy, hv.Z)
        else
            if floor and t > slideBlock and (state == "Idle" or state == "Walk" or state == "Crouch" or state == "Crawl" or state == "Skid" or state == "Land" or state == "DiveSlide" or state == "SlideKick" or state == "Bonk") then
                local fh = workspace:Raycast(root.Position, Vector3.new(0, -(feetOffset() + 2.5), 0), rayParams)
                if fh and fh.Normal.Y < math.cos(math.rad(CFG.SlideAngle)) then
                    local fd = flat(Vector3.new(0, -1, 0) + fh.Normal * fh.Normal.Y)
                    if fd.Magnitude > 0.05 then
                        fd = fd.Unit
                        local downhillWalk = state == "Walk" and wantYaw ~= nil and dirOf(wantYaw):Dot(fd) > 0.5
                        if not downhillWalk and not CFG.StairsHere(fh, wantYaw, fd) then
                            moveYaw = yawOf(fd)
                            faceYaw = moveYaw
                            fVel = math.max(math.min(fVel, 30) * 0.5, 8)
                            setState("Slide")
                            play("slide_sit", 1, 0.08)
                        end
                    end
                end
            end
            do
                local nowL = os.clock()
                local hdt = math.min(nowL - (_M.lookClock or nowL), 0.1)
                _M.lookClock = nowL
                local mvx = _M.touchStick and _M.touchStick.Magnitude or _M.controls:GetMoveVector().Magnitude
                if _M.lookWant and (state ~= "Idle" or dead or _M.menuBlock or mvx > 0.3 or fresh("jump") or fresh("attack") or fresh("crouch") or emoteRequest or grabRequest) then _M.lookWant = false end
                if _M.lookWant ~= _M.lookOn then
                    _M.lookOn = _M.lookWant
                    local cam = workspace.CurrentCamera
                    if _M.lookOn then
                        _M.lookAY, _M.lookAP = 0, 0
                        _M.prevCamType = cam.CameraType
                        cam.CameraType = Enum.CameraType.Scriptable
                        if not _M.lookCamConn then
                            -- the camera sits at the BACK OF MARIO'S HEAD (close, a little above) and looks the way his body faces, so you watch his head turn
                            _M.lookCamConn = RunService.RenderStepped:Connect(function(rdt)
                                    if not _M.lookOn then return end
                                    local c = workspace.CurrentCamera
                                    local h = CFG.ModelHeight
                                    local hp = piece["Head"] and piece["Head"].Position or (root.Position + Vector3.new(0, h * 0.8, 0))
                                    local dir = dirOf(faceYaw)
                                    local want = CFrame.lookAt(hp - dir * (h * 0.5) + Vector3.new(0, h * 0.22, 0), hp + dir * (h * 2) - Vector3.new(0, h * 0.05, 0))
                                    c.CFrame = c.CFrame:Lerp(want, math.min(1, rdt * 12))
                            end)
                        end
                    else
                        pcall(function()
                                cam.CameraType = _M.prevCamType or Enum.CameraType.Custom
                                cam.CameraSubject = humanoid
                        end)
                    end
                end
                local ty, tp = 0, 0
                if _M.lookOn then
                    local s2 = _M.stick2 or Vector2.zero
                    if s2.Magnitude < 0.2 then s2 = Vector2.zero end
                    if UIS:IsKeyDown(Enum.KeyCode.Left) then _M.lookAY = math.min((_M.lookAY or 0) + hdt * 2.2, 1.2) end
                    if UIS:IsKeyDown(Enum.KeyCode.Right) then _M.lookAY = math.max((_M.lookAY or 0) - hdt * 2.2, -1.2) end
                    if UIS:IsKeyDown(Enum.KeyCode.Up) then _M.lookAP = math.min((_M.lookAP or 0) + hdt * 1.5, 0.7) end
                    if UIS:IsKeyDown(Enum.KeyCode.Down) then _M.lookAP = math.max((_M.lookAP or 0) - hdt * 1.5, -0.7) end
                    ty = math.clamp(-s2.X * 1.2 + (_M.lookAY or 0), -1.2, 1.2)
                    tp = math.clamp(s2.Y * 0.7 + (_M.lookAP or 0), -0.7, 0.7)
                end
                local hy, hp = _M.headYaw or 0, _M.headPitch or 0
                local kk = math.min(1, hdt * 10)
                _M.headYaw, _M.headPitch = hy + (ty - hy) * kk, hp + (tp - hp) * kk
            end
            if emoteRequest and (state == "Idle") then
                local e = emoteRequest
                emoteRequest = nil
                setState("Emote")
                emoteLen = _M.LOOPED[e] and math.max(trackLength(e, 3), 3) or trackLength(e, 3)
                fVel = 0
                play(e, 1, 0.15)
            end
            emoteRequest = nil
            if state == "Idle" or state == "Walk" or state == "Crouch" or state == "Crawl" or state == "Emote" then
                if state == "Emote" and (wantYaw or fresh("jump") or fresh("attack") or stateTime > emoteLen) then
                    setState("Idle")
                end
                if fresh("jump") and state ~= "Emote" then
                    doJump()
                elseif fresh("attack") and not held.crouch and state ~= "Emote" then
                    startAttack()
                elseif fresh("attack") and held.crouch and (state == "Crouch" or state == "Crawl") then
                    startBreakdance()
                elseif state == "Emote" then
                    groundDrive(0, faceYaw)
                else
                    local crouching = held.crouch
                    local maxSpeed = crouching and CFG.CrawlMax or (held.walk and CFG.WalkMax or CFG.RunMax)
                    local friction = crouching and 40 or CFG.Friction
                    local skid = locomote(dt, mag, wantYaw, maxSpeed, friction)
                    if skid then
                        setState("Skid")
                        play(skidIsBrake and "skid_brake" or "skid_on_ground", 1, 0.05)
                    else
                        -- SM64: just walking / running into a wall only pushes (PushCheck below); a bonk needs a launched move (see groundWallBonk)
                        if state ~= "Bonk" then
                            local moving = fVel > 0.5 or wantYaw ~= nil
                            local newState
                            if crouching then newState = (moving and "Crawl" or "Crouch")
                            else newState = (moving and "Walk" or "Idle") end
                            if state ~= newState then
                                local prev = state
                                local prevLow = prev == "Crouch" or prev == "Crawl"
                                if (newState == "Crouch" or newState == "Crawl") and not prevLow then
                                    play("start_crouching", 1, 0.05)
                                elseif newState == "Crawl" and prev == "Crouch" then
                                    play("start_crawling", 1.3, 0.05)
                                elseif newState == "Crouch" and prev == "Crawl" then
                                    play("stop_crawling", 1.3, 0.05)
                                elseif newState == "Idle" and prevLow then
                                    play("stop_crouching", 1.2, 0.05)
                                end
                                setState(newState)
                            end
                            if newState == "Idle" then
                                idleTime += dt
                                groundDrive(0, faceYaw)
                                if not busy() then
                                    if carried then play("hold_idle", 1, 0.15)
                                    elseif idleTime > CFG.SleepAfter then
                                        lookIdx = 0
                                        play("sleep_idle", 1, 0.2)
                                    else
                                        idleAnim()
                                    end
                                end
                            else
                                idleTime = 0
                                nextLook = 5
