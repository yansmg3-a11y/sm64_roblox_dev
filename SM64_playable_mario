                end)
            end
            local STATE_SFX = {
                Jump = "jump", DoubleJump = "jump2", TripleJump = "jump3", LongJump = "longjump", Backflip = "backflip",
                SideFlip = "jump2", WallKick = "wallkick", Punch1 = "punch", Punch2 = "punch", Kick = "kick",
                AirKick = "kick", SlideKick = "kick", Breakdance = "kick", Dive = "dive", GPStart = "pound", Bonk = "bonk", AirBonk = "bonk",
                Ledge = "land",
            }
            local KIT_SFX = { Punch1 = "kit1", Punch2 = "kit2", Kick = "kit3", LongJump = "kitlong", Backflip = "kitlong",
                Jump = "kwon", DoubleJump = "kna", SideFlip = "kna", TripleJump = "kguy", WallKick = "kbe", Dive = "kthe", Bonk = "kno", AirBonk = "kno" }
            local lastHealth = humanoid.Health
            fxTrack(humanoid.HealthChanged:Connect(function(h)
                        if h < lastHealth and h > 0 then sfx(PK.kit and "kno" or "hurt") end
                        lastHealth = h
            end))
            fxTrack(humanoid.Died:Connect(function() sfx(PK.kit and "kguy" or "death") end))
            -- Every 0.12 s Mario "looks around": 16 rays sideways, 1 up and 8 diagonal-up. From what they hit it works out how enclosed
            -- the place is (outside = open sky and far walls, inside = ceiling and walls close by), how big it is, and how hard the walls
            -- are (stone / metal echo more than grass / fabric). Mario's sounds then get reverb (and an echo in big halls and caves) that
            -- fades smoothly as you walk from outside into a hall, a tunnel or a cave, like the castle and the caves in SM64.
            -- SM64 menu: "Room Echo (SM64)" = on / off, "Room Echo: Whole Game Audio" = also reverb the game's own sounds (Roblox ambient reverb).
            do (function()
                        local SoundService = game:GetService("SoundService")
                        local Players = game:GetService("Players")
                        local RS = game:GetService("RunService")
                        local grp = Instance.new("SoundGroup")
                        grp.Name = "MarioRoomEcho"
                        grp.Volume = 1
                        local rev = Instance.new("ReverbSoundEffect")
                        rev.DecayTime, rev.Density, rev.Diffusion, rev.DryLevel, rev.WetLevel = 1, 1, 1, 0, -80
                        rev.Parent = grp
                        local echo = Instance.new("EchoSoundEffect")
                        echo.Delay, echo.Feedback, echo.DryLevel, echo.WetLevel = 0.2, 0.3, 0, -80
                        echo.Parent = grp
                        grp.Parent = SoundService
                        -- every sound Mario plays is parented to his root part: send them all through the group
                        local function route(o) if o:IsA("Sound") then pcall(function() o.SoundGroup = grp end) end end
                        for _, c in ipairs(root:GetChildren()) do route(c) end
                        local addC = root.ChildAdded:Connect(route)

                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        rp.IgnoreWater = true
                        pcall(function() rp.RespectCanCollide = true end) -- see-through / non solid parts are not walls
                        local function refreshFilter()
                            local list = { character }
                            for _, p in ipairs(Players:GetPlayers()) do if p.Character then list[#list + 1] = p.Character end end
                            local fx = workspace:FindFirstChild("Mario64FX")
                            if fx then list[#list + 1] = fx end
                            rp.FilterDescendantsInstances = list
                        end
                        local M = Enum.Material
                        local HARD, SOFT, ROCK = {}, {}, {}
                        for _, m in ipairs({ M.Concrete, M.Brick, M.Cobblestone, M.Granite, M.Marble, M.Metal, M.DiamondPlate, M.CorrodedMetal, M.Slate, M.Rock, M.Basalt, M.Pavement, M.Limestone, M.Ice, M.Glass, M.Asphalt }) do HARD[m] = true end
                        for _, m in ipairs({ M.Fabric, M.Grass, M.LeafyGrass, M.Sand, M.Snow, M.Mud, M.Ground, M.Foil }) do SOFT[m] = true end
                        for _, m in ipairs({ M.Rock, M.Slate, M.Basalt, M.Limestone, M.Granite, M.Sandstone, M.CrackedLava }) do ROCK[m] = true end
                        local function hardOf(m) return HARD[m] and 1 or (SOFT[m] and 0 or 0.5) end
                        local DIRS, UPD = {}, {}
                        for i = 0, 15 do local a = i / 16 * math.pi * 2; DIRS[#DIRS + 1] = Vector3.new(math.cos(a), 0, math.sin(a)) end
                        for i = 0, 7 do local a = i / 8 * math.pi * 2; UPD[#UPD + 1] = Vector3.new(math.cos(a) * 0.7071, 0.7071, math.sin(a) * 0.7071) end
                        local RANGE = 90
                        local function clamp(x, a, b) return math.max(a, math.min(b, x)) end
                        -- trees, bushes and leaves are not a room: a hit on foliage never counts as a wall or a ceiling
                        local FOLIAGE_WORDS = { "leaf", "leaves", "foliage", "canopy", "branch", "tree", "bush", "shrub", "palm", "pine", "hedge", "vine" }
                        local foliageCache = setmetatable({}, { __mode = "k" })
                        local function isFoliage(inst)
                            if not inst then return false end
                            local c = foliageCache[inst]
                            if c ~= nil then return c end
                            local res = false
                            local o, depth = inst, 0
                            while o and o ~= workspace and depth < 3 do
                                local nm = string.lower(o.Name)
                                for _, w in ipairs(FOLIAGE_WORDS) do
                                    if string.find(nm, w, 1, true) then res = true break end
                                end
                                if res then break end
                                o = o.Parent; depth += 1
                            end
                            foliageCache[inst] = res
                            return res
                        end

                        local room = { label = "outside", E = 0, size = 0, w = 0, hard = 0.5, cave = false, hall = false, sizeN = 0 }
                        shared.M64Room = room
                        local function analyze()
                            local o = root.Position + Vector3.new(0, CFG.ModelHeight * 0.25, 0)
                            local n, hits, sumHit, hardSum, hardN, rockN = #DIRS, 0, 0, 0, 0, 0
                            local minD, maxD = RANGE, 0
                            for _, d in ipairs(DIRS) do
                                local r = workspace:Raycast(o, d * RANGE, rp)
                                if r and isFoliage(r.Instance) then r = nil end
                                if r then
                                    hits += 1; sumHit += r.Distance
                                    hardSum += hardOf(r.Material); hardN += 1
                                    if ROCK[r.Material] then rockN += 1 end
                                    minD = math.min(minD, r.Distance); maxD = math.max(maxD, r.Distance)
                                else
                                    maxD = RANGE
                                end
                            end
                            local up = workspace:Raycast(o, Vector3.new(0, 70, 0), rp)
                            if up and isFoliage(up.Instance) then up = nil end
                            local ceil = up and up.Distance or 70
                            if up then hardSum += hardOf(up.Material); hardN += 1; if ROCK[up.Material] then rockN += 1 end end
                            local diag = 0
                            for _, d in ipairs(UPD) do
                                local r = workspace:Raycast(o, d * 70, rp)
                                if r and isFoliage(r.Instance) then r = nil end
                                if r then
                                    diag += 1
                                    hardSum += hardOf(r.Material); hardN += 1
                                    if ROCK[r.Material] then rockN += 1 end
                                end
                            end
                            -- a roof alone (tree, awning, bridge, porch) is still outside: a real room also has walls around you.
                            -- wallGate is 0 when fewer than ~25% of the sideways rays hit a wall and 1 when about 60% or more do.
                            local wallGate = clamp((hits / n - 0.25) / 0.35, 0, 1)
                            local E = (0.4 * (up and 1 or 0) + 0.3 * (diag / 8) + 0.3 * (hits / n)) * wallGate
                            local avgHit = hits > 0 and sumHit / hits or RANGE
                            local size = 0.6 * avgHit + 0.4 * ceil
                            local x = clamp((E - 0.38) / 0.32, 0, 1)
                            room.E, room.size = E, size
                            room.w = x * x * (3 - 2 * x) -- smoothstep: 0 = outside, 1 = fully enclosed
                            room.sizeN = clamp((size - 8) / 52, 0, 1)
                            room.hard = hardN > 0 and hardSum / hardN or 0.5
                            room.cave = hardN > 0 and rockN / hardN > 0.55 and E > 0.6
                            room.hall = hits >= 6 and minD < 12 and maxD > minD * 2.2 and E > 0.55
                            if room.w < 0.15 then room.label = "outside"
                            elseif room.cave then room.label = "cave"
                            elseif room.hall then room.label = "hallway"
                            elseif room.sizeN < 0.25 then room.label = "small room"
                            elseif room.sizeN < 0.6 then room.label = "room"
                            else room.label = "big hall" end
                        end

                        -- smooth current values -> targets
                        local cur = { decay = 1, wet = -80, dry = 0, ewet = -80, edelay = 0.2 }
                        local tgt = { decay = 1, wet = -80, dry = 0, ewet = -80, edelay = 0.2 }
                        local function setTargets(all)
                            local w, sN, hd = room.w, room.sizeN, room.hard
                            if all or w < 0.03 then
                                tgt.wet, tgt.ewet, tgt.dry = -80, -80, 0
                                return
                            end
                            local decay = (0.5 + 4.0 * sN) * (0.75 + 0.5 * hd)
                            if room.cave then decay *= 1.5 end
                            if room.hall then decay *= 1.15 end
                            tgt.decay = clamp(decay, 0.3, 9)
                            tgt.wet = math.min(-26 + 20 * w + 6 * sN + 4 * (hd - 0.5) + (room.cave and 3 or 0), -2)
                            tgt.dry = -2 * w
                            local k = clamp((sN - 0.45) / 0.35, 0, 1) * clamp((w - 0.6) / 0.3, 0, 1)
                            if room.cave then k = math.max(k, 0.6 * w) end
                            tgt.ewet = k < 0.05 and -80 or (-26 + 12 * k)
                            tgt.edelay = 0.1 + 0.3 * sN
                        end

                        -- "whole game audio": Roblox ambient reverb type for the room (switches only after the same room type stays for 0.6 s)
                        local origAmb, ambPending, ambSince = nil, nil, 0
                        local function ambientFor()
                            local R = Enum.ReverbType
                            if room.label == "outside" then return R.NoReverb end
                            local stone = room.hard > 0.55
                            if room.cave then return R.Cave end
                            if room.hall then return stone and R.StoneCorridor or R.Hallway end
                            if room.label == "small room" then return stone and R.StoneRoom or R.Room end
                            if room.label == "room" then return stone and R.StoneRoom or R.LivingRoom end
                            return room.sizeN > 0.8 and R.ConcertHall or R.Auditorium
                        end
                        local function restoreAmb()
                            if origAmb ~= nil then pcall(function() SoundService.AmbientReverb = origAmb end); origAmb = nil end
                            ambPending = nil
                        end

                        local hb, acc, filtT = nil, 0, 0
                        local function cleanup()
                            pcall(function() hb:Disconnect() end)
                            pcall(function() addC:Disconnect() end)
                            restoreAmb()
                            pcall(function() for _, s in ipairs(root:GetChildren()) do if s:IsA("Sound") and s.SoundGroup == grp then s.SoundGroup = nil end end end)
                            pcall(function() grp:Destroy() end)
                            shared.M64Room = nil
                        end
                        hb = RS.Heartbeat:Connect(function(dt)
                                if PK.killed or not character:IsDescendantOf(game) then cleanup() return end
                                local on = opts.roomEcho ~= false
                                local all = on and opts.roomEchoAll == true
                                if on then
                                    acc += dt; filtT += dt
                                    if filtT > 2 then filtT = 0; pcall(refreshFilter) end
                                    if acc >= 0.12 then
                                        acc = 0
                                        local ok = pcall(analyze)
                                        if ok then setTargets(all) end
                                    end
                                else
                                    tgt.wet, tgt.ewet, tgt.dry = -80, -80, 0
                                    room.label = "off"
                                end
                                if all then
                                    local want = ambientFor()
                                    if want ~= ambPending then ambPending, ambSince = want, os.clock() end
                                    if os.clock() - ambSince > 0.6 and SoundService.AmbientReverb ~= want then
                                        if origAmb == nil then origAmb = SoundService.AmbientReverb end
                                        pcall(function() SoundService.AmbientReverb = want end)
                                    end
                                elseif origAmb ~= nil then
                                    restoreAmb()
                                end
                                local a = 1 - math.exp(-4 * dt)
                                for k, v in pairs(tgt) do cur[k] += (v - cur[k]) * a end
                                pcall(function()
                                        rev.DecayTime = clamp(cur.decay, 0.1, 20)
                                        rev.WetLevel = clamp(cur.wet, -80, 20)
                                        rev.DryLevel = clamp(cur.dry, -80, 20)
                                        echo.WetLevel = clamp(cur.ewet, -80, 10)
                                        echo.Delay = clamp(cur.edelay, 0.05, 1)
                                end)
                        end)
                end)() end

            local wings = {}
            local wingsBuilt = false
            local WING_COLOR = Color3.fromRGB(252, 252, 255)
            local WING_TIP = Color3.fromRGB(225, 228, 240)
            local function buildWings()
                if wingsBuilt then return end
                wingsBuilt = true
                local head = piece["Head"]
                local hs = head.Size
                local hz = hs.Z
                -- {length, width, sweep angle in degrees} - five overlapping rounded feathers per wing
                local FEATHER = { { 1.00, 0.30, 0 }, { 1.05, 0.30, 17 }, { 0.98, 0.28, 35 }, { 0.84, 0.26, 54 }, { 0.64, 0.24, 76 } }
                -- real SM64 wing pictures (flat wing with the picture on both faces); falls back to the feathers below
                local imgR, imgL = EMB64.getImg("wing_r"), EMB64.getImg("wing_l")
                if imgR and imgL then
                    local L = hz * 1.5
                    for _, side in ipairs({ -1, 1 }) do
                        local pivot = Instance.new("Part")
                        pivot.Name = "FXPivot"
                        pivot.Size = Vector3.new(0.2, 0.2, 0.2)
                        pivot.Transparency = 1
                        pivot.CanCollide = false; pivot.CanQuery = false; pivot.CanTouch = false; pivot.Massless = true; pivot.CastShadow = false
                        pivot.Parent = marioModel
                        local pw = Instance.new("Weld")
                        pw.Part0 = head; pw.Part1 = pivot
                        pw.C0 = CFrame.new(hs.X * 0.28, hs.Y * 0.05, side * hs.Z * 0.5)
                        pw.Parent = pivot
                        local w = { side = side, pivot = pivot, weld = pw, feathers = {}, tex = true, decs = {} }
                        local f = Instance.new("Part")
                        f.Name = "FXWing"
                        f:SetAttribute("FXWing", true)
                        f.Size = Vector3.new(0.05, L, L)
                        f.Transparency = 1
                        f.Material = Enum.Material.SmoothPlastic
                        f.Color = Color3.new(1, 1, 1)
                        f.CanCollide = false; f.CanQuery = false; f.CanTouch = false; f.Massless = true; f.CastShadow = false
                        f.Parent = marioModel
                        -- picture "r" is Mario's right wing seen from the front; the back face gets the mirrored picture
                        for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
                            local d = Instance.new("Decal")
                            d.Face = face
                            d.Transparency = 1
                            d.Parent = f
                            w.decs[#w.decs + 1] = { d = d, letter = ((side == -1) == (face == Enum.NormalId.Left)) and "r" or "l" }
                        end
                        local fw = Instance.new("Weld")
                        fw.Part0 = pivot; fw.Part1 = f
                        fw.C0 = CFrame.new(0, L * 0.4, side * (L * 0.5 + 0.02))
                        fw.Parent = f
                        w.feathers[1] = f
                        wings[#wings + 1] = w
                    end
                    return
                end
                for _, side in ipairs({ -1, 1 }) do
                    local pivot = Instance.new("Part")
                    pivot.Name = "FXPivot"
                    pivot.Size = Vector3.new(0.2, 0.2, 0.2)
                    pivot.Transparency = 1
                    pivot.CanCollide = false; pivot.CanQuery = false; pivot.CanTouch = false; pivot.Massless = true; pivot.CastShadow = false
                    pivot.Parent = marioModel
                    local pw = Instance.new("Weld")
                    pw.Part0 = head; pw.Part1 = pivot
                    pw.C0 = CFrame.new(hs.X * 0.28, hs.Y * 0.05, side * hs.Z * 0.5)
                    pw.Parent = pivot
                    local w = { side = side, pivot = pivot, weld = pw, feathers = {} }
                    for i, fe in ipairs(FEATHER) do
                        local len = hz * 0.95 * fe[1]
                        local width = hz * fe[2]
                        local phi = math.rad(fe[3])
                        local f = Instance.new("Part")
                        f.Name = "FXWing"
                        f:SetAttribute("FXWing", true)
                        f.Size = Vector3.new(hz * 0.09, width, len)
                        f.Color = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(200, 208, 235), (i - 1) / (#FEATHER - 1))
                        f.Material = Enum.Material.SmoothPlastic
                        f.Transparency = 1
                        f.CanCollide = false; f.CanQuery = false; f.CanTouch = false; f.Massless = true; f.CastShadow = false
                        local sm = Instance.new("SpecialMesh")
                        sm.MeshType = Enum.MeshType.Sphere
                        sm.Parent = f
                        f.Parent = marioModel
                        local d = Vector3.new(0, math.sin(phi), side * math.cos(phi))
                        local fw = Instance.new("Weld")
                        fw.Part0 = pivot; fw.Part1 = f
                        fw.C0 = CFrame.new(d * (len / 2 + hz * 0.03)) * CFrame.Angles(-side * phi, 0, 0)
                        fw.Parent = f
                        w.feathers[i] = f
                    end
                    wings[#wings + 1] = w
                end
            end
            local wingPhase, wingAmp, wingFreq = 0, 0.1, 2.2
            local function updateWings(dt, grounded)
                if not wingsBuilt then return end
                local show = FXS.wing
                local hs = piece["Head"].Size
                local freq, amp, base
                if FXS.gliding then freq, amp, base = 16, 0.55, 0.35
                elseif not grounded then freq, amp, base = 8, 0.32, 0.4
                else freq, amp, base = 2.4, 0.1, 0.5 end
                local a = 1 - math.exp(-8 * dt)
                wingAmp = lerp(wingAmp, amp, a)
                wingFreq = lerp(wingFreq, freq, a)
                wingPhase += dt * wingFreq
                local theta = base + math.sin(wingPhase) * wingAmp
                for _, w in ipairs(wings) do
                    if w.tex then
                        -- flat picture wing: lean back a little and flap up / down around the front-back axis
                        w.weld.C0 = CFrame.new(hs.X * 0.28, hs.Y * 0.05, w.side * hs.Z * 0.5) * CFrame.Angles(0, w.side * 0.3, 0) * CFrame.Angles(-w.side * theta, 0, 0)
                        for _, e in ipairs(w.decs) do
                            local id = EMB64.getImg((FXS.metal and "wingm_" or "wing_") .. e.letter)
                            if id then
                                local c3 = _M.f3(id)
                                local want = c3 or id
                                if e.cur ~= want then e.cur = want; if c3 then pcall(function() e.d.TextureContent = c3 end) else e.d.Texture = id end end
                            end
                            e.d.Transparency = show and 0 or 1
                        end
                    else
                        w.weld.C0 = CFrame.new(hs.X * 0.28, hs.Y * 0.05, w.side * hs.Z * 0.5) * CFrame.Angles(0, w.side * theta, 0)
                        for _, f in ipairs(w.feathers) do
                            f.Transparency = show and 0 or 1
                        end
                    end
                end
            end
            local function setWing(on, silent)
                FXS.wing = on and true or false
                if not silent then sfx("cap") end
                if not PK.netpeer then player:SetAttribute("M64Wing", FXS.wing) end
                if FXS.wing then
                    buildWings()
                    if not silent then stars(root.Position + Vector3.new(0, CFG.ModelHeight * 0.4, 0), 10, 8, 1) end
                else
                    FXS.gliding = false
                end
            end

            local METAL_COLOR = Color3.fromRGB(190, 196, 210)
            local metalTex = nil
            local origLook = {}
            local function applyMetal(on)
                if on and metalTex == nil then
                    metalTex = false
                    if CFG.TextureId == "" and _M.textureContent then
                        local ok, res = pcall(buildTexture, true)
                        if ok and res then metalTex = res end
                    end
                end
                for _, d in ipairs(marioModel:GetDescendants()) do
                    if d:IsA("BasePart") and not d:GetAttribute("FXWing") and d.Name ~= "FXPivot" and d.Name ~= "M64Hitbox" then
                        if on then
                            if not origLook[d] then
                                local o = { Color = d.Color, Material = d.Material, Reflectance = d.Reflectance }
                                if d:IsA("MeshPart") then
                                    o.TextureID = d.TextureID
                                    pcall(function() o.TextureContent = d.TextureContent end)
                                end
                                origLook[d] = o
                            end
                            local saFace = d:FindFirstChildOfClass("SurfaceAppearance")
                            if saFace then _M.SAStore = _M.SAStore or {}; _M.SAStore[d] = saFace; saFace.Parent = nil end
                            local ref = d:IsA("MeshPart") and CFG.MeshRef[d] or nil
                            local metalImg = ref and EMB64.getImg("metal") or nil
                            if metalImg then
                                -- real SM64 metal picture, sphere-mapped from the normals (reflection look)
                                if not ref.metal then
                                    ref.metal = true
                                    for _, e in ipairs(ref.faces) do pcall(function() ref.em:SetFaceUVs(e[1], e[3]) end) end
                                end
                                local mc = _M.f3(metalImg)
                                if mc then pcall(function() d.TextureContent = mc end) else pcall(function() d.TextureID = metalImg end) end
                                d.Color = Color3.new(1, 1, 1)
                            elseif d:IsA("MeshPart") then
                                if metalTex then
                                    -- same SM64 shading, but chrome-grey (keeps his face, cap and overalls readable)
                                    pcall(function() d.TextureContent = metalTex end)
                                    d.Color = Color3.new(1, 1, 1)
                                else
                                    pcall(function() d.TextureID = "" end)
                                    pcall(function() d.TextureContent = Content.none end)
                                    d.Color = METAL_COLOR
                                end
                            else
