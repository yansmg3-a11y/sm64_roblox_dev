local reported = false
local function reportError(err)
    pcall(function()
            if reported then return end
            reported = true
            local lp = game:GetService("Players").LocalPlayer
            local g = Instance.new("ScreenGui")
            g.Name = "MarioError"
            g.ResetOnSpawn = false
            g.DisplayOrder = 999
            g.IgnoreGuiInset = true
            g.Parent = lp:WaitForChild("PlayerGui")
            local f = Instance.new("Frame")
            f.Size = UDim2.new(0.92, 0, 0, 230)
            f.Position = UDim2.new(0.04, 0, 0, 12)
            f.BackgroundColor3 = Color3.fromRGB(120, 10, 10)
            f.BorderSizePixel = 0
            f.Parent = g
            Instance.new("UICorner", f).CornerRadius = UDim.new(0, 10)
            local t = Instance.new("TextLabel")
            t.Size = UDim2.new(1, -60, 0, 28)
            t.Position = UDim2.new(0, 10, 0, 6)
            t.BackgroundTransparency = 1
            t.TextXAlignment = Enum.TextXAlignment.Left
            t.Font = Enum.Font.GothamBold
            t.TextSize = 16
            t.TextColor3 = Color3.new(1, 1, 1)
            t.Text = "MARIO SCRIPT ERROR - copy the text below and send it"
            t.Parent = f
            local b = Instance.new("TextBox")
            b.Size = UDim2.new(1, -20, 1, -48)
            b.Position = UDim2.new(0, 10, 0, 38)
            b.BackgroundColor3 = Color3.fromRGB(40, 0, 0)
            b.TextColor3 = Color3.fromRGB(255, 220, 220)
            b.TextXAlignment = Enum.TextXAlignment.Left
            b.TextYAlignment = Enum.TextYAlignment.Top
            b.Font = Enum.Font.Code
            b.TextSize = 14
            b.TextWrapped = true
            b.MultiLine = true
            b.ClearTextOnFocus = false
            b.Text = string.sub(tostring(err), 1, 1200)
            b.Parent = f
            local x = Instance.new("TextButton")
            x.Size = UDim2.fromOffset(40, 28)
            x.Position = UDim2.new(1, -46, 0, 6)
            x.Text = "X"
            x.Font = Enum.Font.GothamBold
            x.TextSize = 16
            x.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
            x.TextColor3 = Color3.new(1, 1, 1)
            x.Parent = f
            x.Activated:Connect(function() g:Destroy() end)
    end)
end
-- A small toast that appears once when the script starts: the message first, then Mario hops, spins and holds up a Power Star
-- (the "got star" move). Set SHOW_LOAD_POPUP to false to turn it off. Needs Allow Mesh / Image APIs for the pictures
-- (without it a red "M" badge and a star symbol are shown instead).
do
    local SHOW_LOAD_POPUP = true
    if SHOW_LOAD_POPUP then
        task.spawn(function()
                local okP, errP = pcall(function()
                        local Players = game:GetService("Players")
                        local TweenService = game:GetService("TweenService")
                        local RunService = game:GetService("RunService")
                        local UIS = game:GetService("UserInputService")
                        local lp = Players.LocalPlayer
                        local pg = lp:WaitForChild("PlayerGui")
                        if pg:FindFirstChild("MarioLoadPopup") then return end -- a second copy of the script does not stack a second pop-up
                        local SPR = {
                            mario = { w = 54, h = 72, pal = "FFFFFFFFFFFEFFFEFEF8FBFCF3F3F3EEEDEDEFECAEFCD197FBC46EF0B674E2CAA5CDCFC8DCAB71DFA46BF07063B3926F796172CD261C791E116C1B0D482140FE0303FE0101EF0304CA041D4407650704B50001CCFF0006FF0000FB0000F30001E90000B200031800B00000FF0000FD0000F20000D2000000",
                                rle = "" },
                            star = { w = 24, h = 24, pal = "FEF57AFEF638FEE71EFDDE0EE8BF14E39303B88001BE6200A04F03541204000002000000",
                                rle = "" },
                        }
                        local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
                        local keep = {}
                        -- builds a picture (palette + run-length, transparent where the palette index is missing); flip = mirrored left to right
                        local function build(s, flip)
                            local ok, res = pcall(function()
                                    local lut = {}
                                    for i = 1, 64 do lut[B64:sub(i, i)] = i - 1 end
                                    local pal = {}
                                    for i = 0, #s.pal / 6 - 1 do
                                        local h = s.pal:sub(i * 6 + 1, i * 6 + 6)
                                        pal[i] = { tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16) }
                                    end
                                    local w, h = s.w, s.h
                                    local buf = buffer.create(w * h * 4)
                                    local n = 0
                                    local rle = s.rle
                                    for i = 1, #rle, 3 do
                                        local col = pal[lut[rle:sub(i, i)]]
                                        local len = lut[rle:sub(i + 1, i + 1)] * 64 + lut[rle:sub(i + 2, i + 2)] + 1
                                        for _ = 1, len do
                                            if col then
                                                local x, y = n % w, n // w
                                                if flip then x = w - 1 - x end
                                                local o = (y * w + x) * 4
                                                buffer.writeu8(buf, o, col[1]); buffer.writeu8(buf, o + 1, col[2]); buffer.writeu8(buf, o + 2, col[3]); buffer.writeu8(buf, o + 3, 255)
                                            end
                                            n += 1
                                        end
                                    end
                                    local img = game:GetService("AssetService"):CreateEditableImage({ Size = Vector2.new(w, h) })
                                    img:WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), buf)
                                    keep[#keep + 1] = img -- keep a reference so it is never collected
                                    return Content.fromObject(img)
                            end)
                            if ok then return res end
                            return nil
                        end
                        local marioFront, marioBack, starPic = build(SPR.mario, false), build(SPR.mario, true), build(SPR.star, false)

                        local hint = "Press Enter for the SM64 menu."
                        if UIS.TouchEnabled and not UIS.KeyboardEnabled then hint = "Tap START for the SM64 menu."
                        elseif UIS.GamepadEnabled and not UIS.KeyboardEnabled then hint = "Press START for the SM64 menu." end

                        local gui = Instance.new("ScreenGui")
                        gui.Name = "MarioLoadPopup"
                        gui.ResetOnSpawn = false
                        gui.IgnoreGuiInset = true
                        gui.DisplayOrder = 90
                        gui.Parent = pg

                        local W, H = 290, 106 -- (the card is taller now: room for the credit line at the bottom)
                        local MX, MW, MH = 46, 48, 64 -- Mario: centre x, width, height inside the card
                        local FLOOR = 84 - 10 -- Mario's floor stays where it was
                        local card = Instance.new("Frame")
                        card.AnchorPoint = Vector2.new(1, 1)
                        card.Size = UDim2.fromOffset(W, H)
                        card.Position = UDim2.new(1, W + 40, 1, -24) -- starts off screen on the right
                        card.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
                        card.BorderSizePixel = 0
                        card.Active = false
                        card.Parent = gui
                        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 12)
                        local stroke = Instance.new("UIStroke")
                        stroke.Color = Color3.fromRGB(255, 214, 10)
                        stroke.Thickness = 2
                        stroke.Parent = card
                        local bar = Instance.new("Frame") -- red / blue strip like the page header
                        bar.Size = UDim2.new(1, -24, 0, 4)
                        bar.Position = UDim2.fromOffset(12, 0)
                        bar.BackgroundColor3 = Color3.fromRGB(229, 37, 33)
                        bar.BorderSizePixel = 0
                        bar.Parent = card
                        Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

                        local title = Instance.new("TextLabel")
                        title.BackgroundTransparency = 1
                        title.Position = UDim2.fromOffset(94, 14)
                        title.Size = UDim2.fromOffset(W - 104, 22)
                        title.TextXAlignment = Enum.TextXAlignment.Left
                        title.Font = Enum.Font.GothamBold
                        title.TextSize = 17
                        title.TextColor3 = Color3.fromRGB(255, 214, 10)
                        title.Text = "Mario 64 loaded!"
                        title.TextTransparency = 1
                        title.Parent = card
                        local body = Instance.new("TextLabel")
                        body.BackgroundTransparency = 1
                        body.Position = UDim2.fromOffset(94, 38)
                        body.Size = UDim2.fromOffset(W - 104, 36)
                        body.TextXAlignment = Enum.TextXAlignment.Left
                        body.TextYAlignment = Enum.TextYAlignment.Top
                        body.Font = Enum.Font.GothamMedium
                        body.TextSize = 13
                        body.TextWrapped = true
                        body.TextColor3 = Color3.fromRGB(230, 230, 245)
                        body.Text = hint
                        body.TextTransparency = 1
                        body.Parent = card
                        local credit = Instance.new("TextLabel") -- bottom-left of the card
                        credit.BackgroundTransparency = 1
                        credit.Position = UDim2.fromOffset(12, 82)
                        credit.Size = UDim2.fromOffset(W - 24, 18)
                        credit.TextXAlignment = Enum.TextXAlignment.Left
                        credit.Font = Enum.Font.GothamMedium
                        credit.TextSize = 12
                        credit.TextColor3 = Color3.fromRGB(140, 200, 255)
                        credit.Text = "Multiplayer by Error101_s"
                        credit.TextTransparency = 1
                        credit.Parent = card

                        local shadow = Instance.new("Frame")
                        shadow.AnchorPoint = Vector2.new(0.5, 0.5)
                        shadow.Position = UDim2.fromOffset(MX, FLOOR)
                        shadow.Size = UDim2.fromOffset(34, 7)
                        shadow.BackgroundColor3 = Color3.new(0, 0, 0)
                        shadow.BackgroundTransparency = 1
                        shadow.BorderSizePixel = 0
                        shadow.Parent = card
                        Instance.new("UICorner", shadow).CornerRadius = UDim.new(1, 0)

                        local hero = Instance.new("ImageLabel")
                        hero.AnchorPoint = Vector2.new(0.5, 1)
                        hero.BackgroundTransparency = 1
                        hero.BorderSizePixel = 0
                        hero.Position = UDim2.fromOffset(MX, FLOOR)
                        hero.Size = UDim2.fromOffset(MW, MH)
                        hero.ImageTransparency = 1
                        hero.ZIndex = 2
                        pcall(function() hero.ResampleMode = Enum.ResamplerMode.Pixelated end)
                        if marioFront then
                            hero.ImageContent = marioFront
                        else -- no image access: red badge with an M
                            hero.BackgroundColor3 = Color3.fromRGB(229, 37, 33)
                            hero.BackgroundTransparency = 1
                            local m = Instance.new("TextLabel")
                            m.BackgroundTransparency = 1
                            m.Size = UDim2.fromScale(1, 1)
                            m.Font = Enum.Font.GothamBlack
                            m.TextSize = 34
                            m.TextColor3 = Color3.new(1, 1, 1)
                            m.Text = "M"
                            m.ZIndex = 3
                            m.Parent = hero
                            Instance.new("UICorner", hero).CornerRadius = UDim.new(1, 0)
                        end
                        hero.Parent = card

                        local star = Instance.new("ImageLabel")
                        star.AnchorPoint = Vector2.new(0.5, 0.5)
                        star.BackgroundTransparency = 1
                        star.BorderSizePixel = 0
                        star.Size = UDim2.fromOffset(0, 0)
                        star.ImageTransparency = 1
                        star.ZIndex = 4
                        pcall(function() star.ResampleMode = Enum.ResamplerMode.Pixelated end)
                        local starFallback
                        if starPic then
                            star.ImageContent = starPic
                        else
                            starFallback = Instance.new("TextLabel")
                            starFallback.BackgroundTransparency = 1
                            starFallback.Size = UDim2.fromScale(1, 1)
                            starFallback.Font = Enum.Font.GothamBold
                            starFallback.TextScaled = true
                            starFallback.TextColor3 = Color3.fromRGB(255, 222, 10)
                            starFallback.Text = utf8.char(0x2605)
                            starFallback.TextTransparency = 1
                            starFallback.ZIndex = 4
                            starFallback.Parent = star
                        end
                        star.Parent = card

                        local function sparkle(cx, cy)
                            for i = 1, 8 do
                                local a = (i / 8) * math.pi * 2 + 0.3
                                local p = Instance.new("Frame")
                                p.AnchorPoint = Vector2.new(0.5, 0.5)
                                p.Size = UDim2.fromOffset(7, 7)
                                p.Rotation = 45
                                p.Position = UDim2.fromOffset(cx, cy)
                                p.BorderSizePixel = 0
                                p.BackgroundColor3 = (i % 2 == 0) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 222, 10)
                                p.ZIndex = 5
                                p.Parent = card
                                local d = 26 + (i % 3) * 7
                                local tw = TweenService:Create(p, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                        Position = UDim2.fromOffset(cx + math.cos(a) * d, cy + math.sin(a) * d),
                                        Size = UDim2.fromOffset(2, 2), BackgroundTransparency = 1 })
                                tw:Play()
                                task.delay(0.6, function() p:Destroy() end)
                            end
                        end

                        local function tween(o, t, props, style, dir)
                            local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
                            tw:Play()
                            return tw
                        end
                        local function easeOutBack(k) local c = 1.70158; k = k - 1; return 1 + (c + 1) * k * k * k + c * k * k end

                        -- 1) the message slides in
                        tween(card, 0.45, { Position = UDim2.new(1, -16, 1, -24) }, Enum.EasingStyle.Back)
                        task.wait(0.25)
                        tween(title, 0.3, { TextTransparency = 0 })
                        tween(body, 0.3, { TextTransparency = 0 })
                        tween(credit, 0.3, { TextTransparency = 0 })
                        task.wait(0.45)
                        -- 2) then Mario shows up
                        if marioFront then tween(hero, 0.2, { ImageTransparency = 0 }) else tween(hero, 0.2, { BackgroundTransparency = 0 }) end
                        tween(shadow, 0.2, { BackgroundTransparency = 0.55 })
                        task.wait(0.25)
                        tween(hero, 0.12, { Size = UDim2.fromOffset(MW + 4, MH - 8) }) -- crouch before the jump
                        task.wait(0.14)

                        -- 3) star get: jump, hold the star up while spinning, land
                        local T_UP, T_SPIN, T_DOWN, HOLD = 0.3, 1.2, 0.3, 3.0
                        local APEX = 24
                        local e = 0
                        local side = true
                        local popped, spark2, landed = false, false, false
                        while gui.Parent and e < T_UP + T_SPIN + T_DOWN + HOLD do
                            e += RunService.Heartbeat:Wait()
                            local y, ang, sq = 0, 0, 1
                            if e < T_UP then
                                local k = e / T_UP
                                y = APEX * math.sin(k * math.pi / 2)
                                sq = 1 + 0.08 * math.sin(k * math.pi / 2)
                            elseif e < T_UP + T_SPIN then
                                local k = (e - T_UP) / T_SPIN
                                y = APEX + 2.5 * math.sin(k * math.pi * 4)
                                ang = k * math.pi * 2
                                if not popped then popped = true; sparkle(MX, FLOOR - MH - APEX - 14) end
                                if not spark2 and k > 0.55 then spark2 = true; sparkle(MX, FLOOR - MH - APEX - 14) end
                            elseif e < T_UP + T_SPIN + T_DOWN then
                                local k = (e - T_UP - T_SPIN) / T_DOWN
                                y = APEX * (1 - k * k)
                            else
                                if not landed then
                                    landed = true
                                    tween(hero, 0.08, { Size = UDim2.fromOffset(MW + 4, MH - 6) }) -- little squash on landing
                                    task.delay(0.1, function() if hero.Parent then tween(hero, 0.12, { Size = UDim2.fromOffset(MW, MH) }) end end)
                                end
                            end
                            if not landed then
                                local c = math.cos(ang)
                                local wnow = math.max(5, MW * math.abs(c))
                                hero.Size = UDim2.fromOffset(wnow, MH * sq)
                                if marioFront then hero.ImageContent = (c >= 0) and marioFront or marioBack end
                            end
                            hero.Position = UDim2.fromOffset(MX, FLOOR - y)
                            local hf = math.clamp(y / APEX, 0, 1)
                            shadow.Size = UDim2.fromOffset(34 - 12 * hf, 7 - 2 * hf)
                            shadow.BackgroundTransparency = 0.55 + 0.25 * hf
                            -- the Power Star pops up above his head, then bobs
                            if e >= T_UP then
                                local sk = math.clamp((e - T_UP) / 0.3, 0, 1)
                                local sz = 30 * easeOutBack(sk)
                                local bob = (e > T_UP + T_SPIN) and 2.5 * math.sin(e * 5) or 0
                                star.Size = UDim2.fromOffset(math.max(sz, 0), math.max(sz, 0))
                                star.Position = UDim2.fromOffset(MX, FLOOR - MH - y - 14 + bob)
                                star.Rotation = 10 * math.sin(e * 7)
                                star.ImageTransparency = 1 - sk
                                if starFallback then starFallback.TextTransparency = 1 - sk end
                            end
                        end

                        -- 4) fade the star and slide the card away
                        tween(star, 0.3, { ImageTransparency = 1 })
                        if starFallback then tween(starFallback, 0.3, { TextTransparency = 1 }) end
                        tween(card, 0.45, { Position = UDim2.new(1, W + 40, 1, -24) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                        task.wait(0.5)
                        gui:Destroy()
                end)
                if not okP then pcall(function() warn("[Mario64] load pop-up failed: " .. tostring(errP)) end) end
        end)
    end
end
-- Pursuitcore mode is OFF when you start: the script behaves like the normal Mario 64 script.
-- Turn it on in the SM64 menu (scroll down > "Pursuitcore mode"). Then a "PC" button (top right) shows its settings.
