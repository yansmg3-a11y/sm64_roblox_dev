    -- knockback. src = where it came from, vel = a velocity that was forced on Mario (keeps it instead of making a new one)
    local function accKnock(dmgFrac, src, vel)
        local away
        if vel and flat(vel).Magnitude > 8 then away = flat(vel) end
        if not away and src then away = flat(root.Position - src) end
        if not away or away.Magnitude < 0.1 then away = -dirOf(faceYaw) end
        away = away.Unit
        local front = dirOf(faceYaw):Dot(-away) > 0 -- it came from the front: knocked backwards. from behind: knocked forwards
        faceYaw = front and yawOf(-away) or yawOf(away)
        local hard = dmgFrac >= 0.2
        local g = math.max(CFG.NetG(), 1)
        local cur = root.AssemblyLinearVelocity
        ACC.mode, ACC.t, ACC.front, ACC.hard, ACC.phase = "Hurt", 0, front, hard, "air"
        local vy = math.sqrt(2 * g * CFG.ModelHeight * (hard and 0.9 or 0.4))
        if vel and flat(vel).Magnitude > 8 then
            local kb = flat(vel)
            if kb.Magnitude > CFG.RunMax * 1.6 then kb = kb.Unit * CFG.RunMax * 1.6 end
            ACC.kb = kb
            vy = cur.Y > 5 and cur.Y or vy
        else
            ACC.kb = away * CFG.RunMax * (hard and 0.95 or 0.55)
        end
        hv, fVel = Vector3.zero, 0
        setState("Hurt")
        launchGrace = 0.12
        root.AssemblyLinearVelocity = Vector3.new(ACC.kb.X, vy, ACC.kb.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
        play(front and "backward_air_kb" or "hurt_back_2", 1, 0.04)
    end
