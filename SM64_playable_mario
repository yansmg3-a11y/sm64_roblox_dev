    -- N64 3-point filter: re-draw a picture K times bigger, blending only the 3 nearest texels (a triangle, not 4 texels)
    function _M.filter3(src, w, h, K, flip, crisp)
        local W, H = w * K, h * K
        local out = buffer.create(W * H * 4)
        local left = (CFG.SM64FilterLeft ~= false) ~= (flip == true) -- flip: Luigi's texture is mirrored, so his triangle is mirrored too
        if PK.kit then left = true end -- The Kit: the 3-point triangle always leans LEFT
        if crisp == "ui" then left = not (CFG.SM64FilterLeft ~= false) end -- pictures on the screen (UI): the triangle goes the way Mario's does on screen (his texture is upside down, so it is the mirror of the texture side)
        local rd, wr = buffer.readu8, buffer.writeu8
        for Y = 0, H - 1 do
            local sy = (Y + 0.5) / K - 0.5
            local ya = math.floor(sy); local fy = sy - ya
            local y0, y1 = math.clamp(ya, 0, h - 1), math.clamp(ya + 1, 0, h - 1)
            for X = 0, W - 1 do
                local sx = (X + 0.5) / K - 0.5
                local xa = math.floor(sx); local fx = sx - xa
                local x0, x1 = math.clamp(xa, 0, w - 1), math.clamp(xa + 1, 0, w - 1)
                local ia, ib = (y0 * w + x0) * 4, (y0 * w + x1) * 4
                local ic, id = (y1 * w + x0) * 4, (y1 * w + x1) * 4
                if left then ia, ib, ic, id = ib, ia, id, ic; fx = 1 - fx end
                -- the 3 nearest texels (a triangle) and their weights
                local p0, p1, p2, w0, w1, w2
                if fx + fy <= 1 then
                    p0, p1, p2, w0, w1, w2 = ia, ib, ic, 1 - fx - fy, fx, fy
                else
                    p0, p1, p2, w0, w1, w2 = id, ic, ib, fx + fy - 1, 1 - fx, 1 - fy
                end
                local o = (Y * W + X) * 4
                -- colours are blended by alpha, so see-through texels do not leave dark edges
                local a0, a1, a2 = rd(src, p0 + 3) * w0, rd(src, p1 + 3) * w1, rd(src, p2 + 3) * w2
                local asum = a0 + a1 + a2
                if asum <= 0.001 then
                    wr(out, o, rd(src, p0)); wr(out, o + 1, rd(src, p0 + 1)); wr(out, o + 2, rd(src, p0 + 2)); wr(out, o + 3, 0)
                else
                    for c = 0, 2 do
                        local v = (a0 * rd(src, p0 + c) + a1 * rd(src, p1 + c) + a2 * rd(src, p2 + c)) / asum
                        wr(out, o + c, math.clamp(math.floor(v + 0.5), 0, 255))
                    end
                    wr(out, o + 3, math.clamp(math.floor(asum + 0.5), 0, 255))
                end
            end
            if H >= 256 and Y % 64 == 63 then task.wait() end
        end
        return out
    end
