                        _M.SP.offset = CFrame.identity
                        _M.LOOPED.spin = nil
                        wasAir, landHold = false, 0.18
                        curName = nil
                        play("general_land", 1, 0.04)
                    else
                        local k = e / _M.SP.fall
                        _M.SP.offset = CFrame.new(0, CFG.ModelHeight * _M.SP.height * (1 - k * k), 0) * CFrame.Angles(0, math.rad(_M.SP.rate) * e, 0)
                        _M.LOOPED.spin = true
                        play("spin", 1, 0.04)
                        return
                    end
                end
                if _M.devAct and os.clock() < _M.devAct.untilT then
                    local da = _M.devAct
                    if da.fresh then da.fresh = false; curName = nil end
                    play(da.anim, 1, 0.04)
                    if PC.FaceLock == nil then pcall(function() character:SetAttribute("M64Face", da.face) end) end
                    lastFace = nil
                    return
                end
                if animObj then
                    for _, t in ipairs(animObj:GetPlayingAnimationTracks()) do
                        if not known[t] then
                            known[t] = true
                            local ok, rule = pcall(classify, t)
                            if ok and rule then
                                local anim = rule[2]
                                if type(anim) == "table" then
